---
/**
 * Base layout — 27zero
 * Shell del documento: `<html>`, `<head>` y `<body>` con los defaults del `body`
 * del repo vanilla (Inter, fondo blanco, texto negro, antialiased, scroll suave).
 *
 * Es el único lugar donde se importa `global.css`, así que a partir de acá los
 * componentes ya no necesitan declarar `font-inter` por su cuenta — se deja el que
 * ya tienen porque quitarlo es una limpieza transversal de la Etapa 3, no de esta.
 *
 * Navbar y Footer NO viven acá: cada página los instancia (el navbar tiene variante
 * por página, `white` / `black`). Si más adelante las 13 páginas terminan repitiendo
 * el mismo par, el lugar para absorberlo es un `Page.astro` sobre este layout.
 *
 * SEO (Etapa 7): todo el `<head>` de metadata lo emite `Metadata.astro`. Este layout
 * ya no toma `title`/`description` sueltos — eran una segunda fuente de SEO por
 * página, justo lo que CLAUDE.md §8 prohíbe. Las páginas pasan un objeto `seo` y el
 * `siteSettings` que resuelve el fallback, y nada más.
 */
import Metadata from '../components/seo/Metadata.astro';
import type { SiteSeoSettings } from '../lib/sanity/settings';
import type { OgType } from '../lib/seo/ogType';
import type { ResolvedSeo } from '../lib/seo/resolveSeo';
import '../styles/global.css';

interface Props {
  seo?: ResolvedSeo;
  siteSettings: SiteSeoSettings;
  ogType?: OgType;
}

const { seo, siteSettings, ogType } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Metadata seo={seo} siteSettings={siteSettings} ogType={ogType} />
  </head>
  <body class="bg-white font-inter text-black antialiased">
    <slot />
  </body>
</html>
