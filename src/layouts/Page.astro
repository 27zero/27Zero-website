---
/**
 * Page — 27zero
 * `Base.astro` + Navbar/Footer instanciados. Absorbe el par que las 13 páginas
 * confirmadas en Etapa 0 repiten siempre (CLAUDE.md §0) — el layout de las páginas
 * deja de reinstanciarlos uno por uno.
 *
 * `navVariant` expone la única prop real de `Navbar` (`white` / `black`, la variante
 * inicial al tope de la página, antes del scroll). Ver Navbar.astro para el resto del
 * comportamiento (nav--scrolled, menú mobile).
 *
 * Las props de SEO (`seo`, `siteSettings`, `ogType`, `article`, `breadcrumb`) pasan de largo hasta
 * `Base.astro` → `Metadata.astro`; este layout no las mira. Las páginas las obtienen
 * de `lib/sanity/settings.ts` (`getPageSeo()` las 8 estáticas/shell,
 * `getSeoSettings()` las 5 internas).
 *
 * Páginas que necesiten omitir Navbar o Footer (ninguna hoy) siguen usando
 * `Base.astro` directo — este layout no reemplaza a `Base.astro`, se apoya en él.
 */
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import type { SiteSeoSettings } from '../lib/sanity/settings';
import type { ArticleInput } from '../lib/seo/generateJsonLd';
import type { OgType } from '../lib/seo/ogType';
import type { ResolvedSeo } from '../lib/seo/resolveSeo';
import type { Crumb } from '../lib/utils/breadcrumbs';
import Base from './Base.astro';

interface Props {
  seo?: ResolvedSeo;
  siteSettings: SiteSeoSettings;
  ogType?: OgType;
  article?: ArticleInput;
  breadcrumb?: Crumb[];
  navVariant?: 'white' | 'black';
}

const { seo, siteSettings, ogType, article, breadcrumb, navVariant = 'white' } = Astro.props;
---

<Base seo={seo} siteSettings={siteSettings} ogType={ogType} article={article} breadcrumb={breadcrumb}>
  <Navbar variant={navVariant} />
  <slot />
  <Footer />
</Base>
