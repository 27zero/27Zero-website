---
/**
 * Final CTA — 27zero
 * Bloque de cierre de la interna de Work (feedback Work, Nota 7.9). Desde la ronda 2
 * (§5) lee un documento `cta` referenciado (`work.cta->`) en vez del objeto embebido
 * `finalCta`: el mismo CTA se reutiliza en varios proyectos. Estructura del resto de los
 * CTA del sitio (`.section--cta-mentor`): headline + bajada + un botón, todo centrado;
 * el headline ocupa hasta el 80% del ancho y la bajada hasta el 70%.
 *
 * Los tres colores son nombres de la paleta del Studio (ronda 2, §4) y se pintan con
 * `var(--color-<nombre>)` vía custom properties inline (`paletteSurface()`):
 *   - fondo vacío o desconocido → purple (ver `DEFAULT_BACKGROUND`);
 *   - headline / cuerpo vacíos → negro o blanco, el que contraste con el fondo.
 * El botón no tiene color propio en el schema: sobre fondo oscuro va `whiteOnDark` (su
 * hover sigue visible), sobre claro `dark`.
 *
 * No se renderiza si no hay nada que mostrar: sin headline, y sin un botón completo
 * (texto + link), la sección quedaría como una franja de color vacía.
 */
import Button from '../ui/Button.astro';
import { paletteSurface, type PaletteName } from '../../lib/utils/color';
import { isExternalHref } from '../../lib/utils/routes';
import type { PaletteColor } from '../../types/sanity';

/** Los campos de contenido del documento `cta`. GROQ devuelve `null` para los vacíos. */
interface Props {
  headline?: string | null;
  bodyText?: string | null;
  ctaText?: string | null;
  ctaLink?: string | null;
  bgColor?: PaletteColor | null;
  headlineColor?: PaletteColor | null;
  bodyTextColor?: PaletteColor | null;
}

const { bgColor, headlineColor, bodyTextColor, headline, bodyText, ctaText, ctaLink } = Astro.props;

/**
 * No indigo: en la interna, el Strategic Idea va sobre indigo, y en un proyecto sin
 * testimonios ni Additional Sections las dos secciones quedarían pegadas con el mismo
 * fondo.
 */
const DEFAULT_BACKGROUND: PaletteName = 'purple';

const { background, text: headlineText, isDark } = paletteSurface(bgColor, headlineColor, DEFAULT_BACKGROUND);
const { text: bodyColor } = paletteSurface(bgColor, bodyTextColor, DEFAULT_BACKGROUND);

const hasButton = Boolean(ctaText?.trim() && ctaLink?.trim());
/* Solo http(s) abre en pestaña nueva: un `mailto:` abre el cliente de correo igual. */
const isExternal = hasButton && isExternalHref(ctaLink);
const isVisible = Boolean(headline?.trim()) || hasButton;

const CONTAINER = 'container mx-auto flex w-full max-w-(--container-max-width) flex-col px-container-x';
---

{
  isVisible && (
    <section
      class="section section--final-cta bg-(--final-cta-bg) py-[clamp(3.2119rem,2.7021rem_+_2.5491vw,4.9962rem)]"
      style={`--final-cta-bg:${background};--final-cta-headline:${headlineText};--final-cta-body:${bodyColor}`}
    >
      <div class:list={[CONTAINER, 'items-center gap-[clamp(1.4063rem,1.183rem_+_1.1161vw,2.1875rem)] text-center']}>
        <div class="flex w-full flex-col items-center gap-[clamp(0.3994rem,0.336rem_+_0.317vw,0.6212rem)]">
          {headline && (
            <h2 class="max-w-[80%] font-lora text-[clamp(1.5rem,1.0711rem_+_2.1446vw,3.0013rem)] leading-[1.25] font-medium tracking-[-0.36px] text-(--final-cta-headline)">
              {headline}
            </h2>
          )}
          {bodyText && (
            <p class="max-w-[70%] font-inter text-body leading-[1.6] font-medium tracking-normal text-(--final-cta-body)">
              {bodyText}
            </p>
          )}
        </div>

        {hasButton && (
          <div class="flex flex-wrap justify-center">
            <Button
              href={ctaLink!.trim()}
              variant={isDark ? 'whiteOnDark' : 'dark'}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener' : undefined}
            >
              {ctaText}
            </Button>
          </div>
        )}
      </div>
    </section>
  )
}
