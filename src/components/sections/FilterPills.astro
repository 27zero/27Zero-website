---
/**
 * Filter Pills — 27zero
 * Portado 1:1 de la sección de pills de `/work` del repo vanilla
 * (markup de `work/index.html` + estilos de `work/style.css` + `work/script.js`).
 *
 * Antepone siempre un primer pill (por default el "All" hardcodeado, activo) a las
 * categorías recibidas. Click en un pill con `data-filter`: mueve el estado
 * `pill--active` entre los pills con `data-filter` y, si no es "All", scrollea al
 * `.category-anchor` cuyo `id` coincide con su `data-filter`. "All" solo togglea el
 * estado visual, sin scroll — comportamiento del vanilla, pendiente de confirmar con
 * cliente si además debería filtrar (planning-maquetado-work.md #1).
 *
 * `leadPill` (Etapa 4, EdTech Mentor): reemplaza el "All" por un pill custom — link
 * externo real ("Subscribe on LinkedIn"), sin `data-filter`, así que el `<script>` lo
 * ignora del todo (ni participa del toggle activo ni intenta scrollear). Sin este
 * prop, Work/Clientes no cambian: el "All" hardcodeado sigue siendo el default.
 *
 * `indent` (Etapa 4, EdTech Mentor): Work/Clientes indentan `.pills-container` 13em
 * a la izquierda (mismo indent que su hero) — EdTech Mentor no, su `.pills-container`
 * solo cambia `flex-direction`, el padding queda el estándar de `.container`. Default
 * `true` preserva el comportamiento de Work/Clientes sin que pasen nada.
 *
 * Feedback EdTech Mentor — todo opt-in, Work/Clientes no cambian:
 *   - `categories[].color` (Nota 5.1): borde y texto del pill en el color de la
 *     categoría; en hover y activo, relleno de ese color con texto en
 *     `categories[].textColor` (segunda ronda) o, si no hay, por contraste.
 *   - `leadPill.class` (Nota 13.1): EdTech Mentor lo oculta en mobile, donde lo
 *     reemplaza el pill flotante de la página.
 *   - `mobileSelect` (Nota 13.2): en mobile los pills de categoría se cambian por un
 *     `<select>` nativo que scrollea a la misma sección, y la fila deja de scrollear
 *     en horizontal. Nativo y no un listbox propio: accesible y usable con teclado y
 *     lector de pantalla sin JS extra, y en mobile abre el picker del sistema.
 *
 * Sin librería: la lógica va en el `<script>` de este `.astro`, no en una island
 * (CLAUDE.md §7) — no hay estado de React de por medio.
 *
 * NOTA — `pill--active`: `work/style.css` togglea la clase por JS pero nunca la
 * estiliza (no existe la regla en ninguna hoja del vanilla), así que en el repo de
 * referencia el pill activo se ve idéntico a los inactivos. Acá se implementa según
 * `work/design-system-work.md § .pill--active` (fondo y borde purple, texto negro),
 * que es la intención documentada del diseño. Ver reporte de entrega.
 */
import { accentColors } from '../../lib/utils/color';

interface Props {
  /**
   * Sin el lead pill (o el "All" default): lo antepone este componente.
   * `color`: hex de acento ya resuelto (con fallback). Sin él, el pill usa el estilo
   * estándar negro/indigo/purple. `textColor`: texto de hover/activo; vacío → contraste.
   */
  categories: { id: string; label: string; color?: string; textColor?: string }[];
  /** Reemplaza al "All" hardcodeado. Sin `target`/`rel`: navegación interna normal. */
  leadPill?: { label: string; href: string; target?: string; rel?: string; class?: string };
  /**
   * Pill de acción (Etapa 12, EdTech Mentor): un `<button>` que dispara algo en la
   * página en vez de navegar — hoy, abrir el modal de búsqueda. Va en la misma fila y
   * comparte el tratamiento de `leadPill` porque es un CTA, no un filtro de categoría.
   * Sin `data-filter`, así que el `<script>` de acá abajo lo ignora igual que al
   * `leadPill`: no togglea estado activo ni intenta scrollear a un anchor.
   * El comportamiento lo cablea quien lo usa, por `id` — este componente no sabe qué
   * hace el botón.
   */
  actionPill?: { label: string; id: string };
  /** `true` (default) = indent de Work/Clientes. `false` = container estándar. */
  indent?: boolean;
  /** En mobile, `<select>` de categorías en vez de la fila de pills con scroll horizontal. */
  mobileSelect?: boolean;
  /** Clase de `padding-bottom` de la sección. Default: la del vanilla de Work/Clientes. */
  paddingBottom?: string;
}

const {
  categories,
  leadPill,
  actionPill,
  indent = true,
  mobileSelect = false,
  paddingBottom = 'pb-[clamp(4.0162rem,3.3787rem_+_3.1875vw,6.2475rem)]',
} = Astro.props;

/* El hover gana sobre el estado activo, igual que en el vanilla, donde `.pill:hover`
   (0,2,0) le gana a `.pill--active` (0,1,0). Acá `[&.pill--active]:` también es (0,2,0),
   así que el empate lo resolvería el orden de emisión de Tailwind — por eso el hover
   sobre un pill activo se declara explícito en (0,3,0), sin depender de ese orden. */
const PILL =
  'pill inline-flex cursor-pointer items-center rounded-full border-[0.0625rem] border-black bg-transparent px-[clamp(0.7875rem,0.6625rem_+_0.625vw,1.225rem)] py-[clamp(0.3375rem,0.2839rem_+_0.2679vw,0.525rem)] font-inter text-[clamp(0.6019rem,0.5063rem_+_0.4777vw,0.9363rem)] leading-[1.5] font-medium whitespace-nowrap text-black no-underline transition-all duration-200 ease-in-out hover:border-indigo hover:text-indigo [&.pill--active]:border-purple [&.pill--active]:bg-purple [&.pill--active]:text-black [&.pill--active]:hover:border-indigo [&.pill--active]:hover:text-indigo';

/* `.pill--subscribe` del vanilla: siempre purple, incluso en hover (solo baja opacity).
   Necesita `!` porque pisa las mismas utilidades (`border-*`, `bg-*`, `text-*`,
   `hover:border-*`, `hover:text-*`) que ya trae `PILL` — dos utilidades de la misma
   categoría se resuelven por orden de emisión de Tailwind, no por el orden del
   atributo `class`. */
const PILL_SUBSCRIBE =
  'border-purple! bg-purple! text-black! hover:border-purple! hover:bg-purple! hover:text-black! hover:opacity-85';

/* Pill de acción (el "Search" de EdTech Mentor, Nota 4.1): oscuro con texto claro; el
   hover solo baja opacity, mismo criterio que `PILL_SUBSCRIBE`. */
const PILL_ACTION =
  'border-black! bg-black! text-white! hover:border-black! hover:bg-black! hover:text-white! hover:opacity-75';

/* Pill con color de categoría (Nota 5.1). El color llega por custom property inline —
   viene del CMS, no existe como utilidad en build. `!` por el mismo motivo que en
   `PILL_SUBSCRIBE`: pisa utilidades que `PILL` ya declara para los mismos estados. */
const PILL_ACCENT =
  'border-(--pill-accent)! text-(--pill-accent)! hover:bg-(--pill-accent)! hover:text-(--pill-accent-text)! [&.pill--active]:bg-(--pill-accent)! [&.pill--active]:text-(--pill-accent-text)!';

/* En mobile los dos controles que quedan (búsqueda y select) van a ancho completo y a
   1rem: por debajo de 16px iOS hace zoom al enfocar un `<select>`. */
const MOBILE_CONTROL = 'max-md:w-full max-md:justify-center max-md:py-[0.625rem] max-md:text-[1rem]';

const CONTAINER_PADDING = indent
  ? 'pr-container-x pl-[clamp(1.125rem,-1.8036rem_+_14.6429vw,11.375rem)]'
  : 'px-container-x';
---

<section class:list={['section section--pills pt-0', paddingBottom]}>
  <div
    class:list={[
      'container pills-container mx-auto flex w-full max-w-(--container-max-width) flex-col gap-gap',
      CONTAINER_PADDING,
    ]}
  >
    <div
      class:list={[
        'pills-wrap flex flex-wrap gap-[clamp(0.4219rem,0.3549rem_+_0.3348vw,0.6563rem)]',
        mobileSelect
          ? 'max-md:flex-col max-md:gap-xs'
          : 'max-md:flex-nowrap max-md:overflow-x-auto max-md:[scrollbar-width:none] max-md:[&::-webkit-scrollbar]:hidden',
      ]}
      id="pillsWrap"
    >
      {
        leadPill ? (
          <a href={leadPill.href} target={leadPill.target} rel={leadPill.rel} class:list={[PILL, PILL_SUBSCRIBE, leadPill.class]}>
            {leadPill.label}
          </a>
        ) : (
          <button class:list={[PILL, 'pill--active']} data-filter="all">
            All
          </button>
        )
      }
      {/* La lupa distingue por función lo que el color no: si no, quedan dos pills
          purple idénticos al lado. El tratamiento visual es el mismo que pide la spec. */}
      {
        actionPill && (
          <button
            type="button"
            id={actionPill.id}
            class:list={[PILL, PILL_ACTION, 'gap-[0.4em]', mobileSelect && MOBILE_CONTROL]}
          >
            <svg
              class="size-[1em] shrink-0"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7" />
              <line x1="16.5" y1="16.5" x2="21" y2="21" />
            </svg>
            {actionPill.label}
          </button>
        )
      }
      {
        categories.map((category) => {
          const accent = category.color ? accentColors(category.color, category.textColor) : undefined;
          return (
            <button
              class:list={[PILL, accent && PILL_ACCENT, mobileSelect && 'max-md:hidden']}
              style={accent ? `--pill-accent:${accent.background};--pill-accent-text:${accent.text}` : undefined}
              data-filter={category.id}
            >
              {category.label}
            </button>
          );
        })
      }

      {
        mobileSelect && (
          <div class="relative w-full md:hidden">
            <label for="pillsSelect" class="sr-only">Jump to a category</label>
            <select
              id="pillsSelect"
              class:list={[
                PILL,
                MOBILE_CONTROL,
                'pills-select w-full appearance-none justify-start pr-[2.75rem] hover:border-black hover:text-black',
              ]}
            >
              <option value="" selected disabled>Browse by category</option>
              {categories.map((category) => <option value={category.id}>{category.label}</option>)}
            </select>
            <svg
              class="pointer-events-none absolute top-1/2 right-[1.125rem] size-[1rem] -translate-y-1/2 text-black"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
            >
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  // ============================
  // Filter Pills — 27zero
  // Click en un pill CON data-filter: mueve el estado activo y scrollea a su
  // `.category-anchor` (salvo "All", que solo togglea el estado). Un pill SIN
  // data-filter (ej. el lead pill de link externo) no participa: ni togglea ni
  // scrollea. Portado de `work/script.js` / `edtech-mentor/script.js`.
  // ============================

  const pillsWrap = document.getElementById('pillsWrap');
  const pillsSelect = document.getElementById('pillsSelect') as HTMLSelectElement | null;

  // Select mobile: mismo destino que el pill equivalente. El valor queda seleccionado
  // como referencia de la sección a la que se saltó.
  pillsSelect?.addEventListener('change', () => {
    document.getElementById(pillsSelect.value)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  if (pillsWrap) {
    pillsWrap.addEventListener('click', (e) => {
      const pill = (e.target as HTMLElement).closest<HTMLElement>('.pill[data-filter]');
      if (!pill) return;

      pillsWrap.querySelectorAll('.pill[data-filter]').forEach((p) => p.classList.remove('pill--active'));
      pill.classList.add('pill--active');

      const filterId = pill.dataset.filter;
      if (!filterId || filterId === 'all') return;

      const target = document.getElementById(filterId);
      if (!target) return;

      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
</script>
