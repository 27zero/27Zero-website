---
/**
 * Mentor Category Section — 27zero
 * UN bloque de categoría de `/edtech-mentor` del repo vanilla: header propio (h2 con
 * acento + subtexto + 2 CTA) + slider sin título de `EdtechMentorCard`. Portado de
 * `.section--essential-mentor` / `.section--investor-mentor` / `.section--founders-mentor`.
 *
 * A diferencia de `ServiceCategoryBlock` (EdTech Marketing), las instancias de esta
 * página NO comparten la misma piel visual — cada una tiene su propio fondo, color de
 * texto y variante de botón (indigo / purple / negro).
 *
 * Desde Etapa 11 las categorías salen del CMS y pueden ser N, así que esa piel no se
 * puede pedir por prop desde la página: se resuelve acá contra `THEMES`, indexado por
 * la POSICIÓN de la sección. `themeIndex` cicla cada 3 — con 4 categorías la cuarta
 * vuelve a indigo, que es el comportamiento buscado (el vanilla nunca definió un
 * cuarto fondo). El campo `color` de `mentorCategory` NO se usa para esto: es el color
 * del pill de categoría, no del fondo de sección, y la categoría "CEOs" ya demuestra
 * la diferencia.
 *
 * El `h2` es Portable Text de una línea, no dos strings: el tramo acentuado lo marca
 * el editor con cursiva en Sanity y lo traduce `accentMarkComponents`, el mismo
 * serializer que usan los headlines de Home (Etapa 10).
 */
import CardsSlider from './CardsSlider.astro';
import EdtechMentorCard from '../ui/EdtechMentorCard.astro';
import Button from '../ui/Button.astro';
import PortableText from '../ui/PortableText.astro';
import { accentMarkComponents } from '../../lib/utils/portableText';
import type { MentorCategoryGroup } from '../../types/ui';

interface Props extends MentorCategoryGroup {
  /**
   * Posición de la sección en la página (0-based). Elige el tema; cicla cada 3.
   * Es el índice del loop y no `order`, que es el criterio de ordenamiento del
   * editor: nada garantiza que sea 1..N contiguo (con `order: 0`, legal en el
   * schema, un `order - 1` se iría a un índice negativo).
   */
  themeIndex: number;
  /** Newsletter de LinkedIn: destino del botón "Subscribe on LinkedIn", el mismo en
      todas las secciones. Abre en pestaña nueva. */
  linkedinUrl: string;
}

/**
 * Los 3 temas del vanilla, en orden de aparición.
 *
 * `cardTextClass` es un override scoped para el rol/nombre dentro de cada
 * `EdtechMentorCard`: por default son blancos (legibles sobre indigo/negro), pero
 * sobre purple el vanilla los pasa a negro
 * (`.section--investor-mentor .card-edtech-mentor-role/-name`). Va como clase
 * arbitraria descendente sobre el wrapper del slider, mismo patrón que el override de
 * altura de card en Work.
 */
const THEMES = [
  {
    sectionClass: 'bg-indigo text-white',
    buttonVariant: 'whiteIndigo' as const,
    arrowVariant: 'light' as const,
    cardTextClass: undefined,
  },
  {
    sectionClass: 'bg-purple text-black',
    buttonVariant: 'blackWhite' as const,
    arrowVariant: 'dark' as const,
    cardTextClass: '[&_.card-edtech-mentor-role]:text-black [&_.card-edtech-mentor-name]:text-black',
  },
  {
    sectionClass: 'bg-black text-white',
    buttonVariant: 'whiteIndigo' as const,
    arrowVariant: 'light' as const,
    cardTextClass: undefined,
  },
];

const { id, title, headline, subtitle, ctaUrl, items, themeIndex, linkedinUrl } = Astro.props;

const theme = THEMES[themeIndex % THEMES.length];

const CONTAINER = 'container mx-auto flex w-full max-w-(--container-max-width) flex-col gap-sm px-container-x';
const HEADING = 'font-lora text-h2 leading-[1.25] font-medium tracking-[-0.36px]';
const SLIDERS_CONTAINER = 'sliders-container pt-[clamp(2.2106rem,1.7697rem_+_2.2045vw,3.7538rem)]';
---

<section
  id={id}
  class:list={[
    'section pt-[clamp(3.8588rem,3.2462rem_+_3.0625vw,6.0025rem)] pb-[clamp(2.5313rem,1.5395rem_+_4.9589vw,6.0025rem)]',
    theme.sectionClass,
  ]}
>
  <div class={CONTAINER}>
    {/* Sin `class` a nivel de componente: emite por Fragment y el `<h2>` sale directo,
        sin `<div>` envolvente. El tag lo pone `classes.h2`. */}
    <PortableText value={headline} classes={{ h2: HEADING }} components={accentMarkComponents} />
    {
      subtitle && (
        <p class="text-body--sm font-inter text-body-sm leading-[1.6] font-normal tracking-normal">{subtitle}</p>
      )
    }
    <div class="flex flex-wrap gap-[clamp(1.125rem,0.9464rem_+_0.8929vw,1.75rem)] max-md:flex-col max-md:items-baseline">
      {/* Sin página de serie cargada no hay a dónde ir: el botón no se renderiza,
          mismo criterio que el resto de los CTA editables de Etapa 10. */}
      {ctaUrl && <Button href={ctaUrl} variant={theme.buttonVariant}>Go to {title}</Button>}
      <Button href={linkedinUrl} target="_blank" rel="noopener" variant={theme.buttonVariant}>
        Subscribe on LinkedIn
      </Button>
    </div>
  </div>

  <div class:list={[SLIDERS_CONTAINER, theme.cardTextClass]}>
    <CardsSlider arrowVariant={theme.arrowVariant}>
      {items.map((item) => <EdtechMentorCard {...item} />)}
    </CardsSlider>
  </div>
</section>
