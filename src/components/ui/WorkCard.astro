---
/**
 * Work Card — 27zero
 * Rediseñada en el feedback de Work (Notas 1 y 2) a partir de `/components/work-card`
 * del repo vanilla. Sin JS: el hover es CSS puro.
 *
 * Antes el texto iba superpuesto a la imagen, sobre un overlay negro al 50%. Ahora:
 *   - `.card-work-bg` es una imagen dentro del flujo (ya no `absolute inset-0`), con el
 *     mismo tamaño que tenía la card, y sin overlay.
 *   - `.card-work-body` va DEBAJO de la imagen, sin padding propio (solo el `gap` que lo
 *     separa de ella), con texto y bordes oscuros.
 *   - `.card-work-arrow` sigue sobre la imagen, abajo a la derecha, en blanco como
 *     antes. `.card-work-bg` es `relative` solo para anclarla: sigue en el flujo.
 *
 * `size="tall"` es la card de las categorías destacadas de Work (Nota 9, antes "Los
 * mejores"): misma anchura, imagen más alta. Es una variante del componente y no un
 * override de la página porque ahora la altura vive en la imagen, no en la card.
 *
 * Las imágenes se reciben como `{ src, alt }` para que el `alt` sea obligatorio a nivel
 * de tipo (CLAUDE.md §8.1). Sin `thumbnail`, la imagen cae al gris del diseño.
 */
interface Props {
  href: string;
  /** `clientTagline` (o el título del proyecto si no hay tagline) — ver `toWorkCard`. */
  title: string;
  eyebrow?: string;
  image?: { src: string; alt: string };
  clientName?: string;
  /** `client.icon`, dentro del círculo. */
  clientIcon?: { src: string; alt: string };
  /** Alternativa al ícono: iniciales del cliente dentro del círculo. */
  clientInitials?: string;
  size?: 'base' | 'tall';
}

const { href, title, eyebrow, image, clientName, clientIcon, clientInitials, size = 'base' } = Astro.props;

/* `base` es el cuadrado de siempre (`--spacing-card`). `tall` llega a 30rem en
   desktop; en mobile arranca en 20rem, el mismo alto que ya tenía "Los mejores" en
   ese extremo. */
const IMAGE_HEIGHT = {
  base: 'h-card',
  tall: 'h-[clamp(20rem,17.1429rem_+_14.2857vw,30rem)]',
} as const;
---

<a
  href={href}
  class="card card--work group/card flex w-card shrink-0 cursor-pointer flex-col gap-[clamp(0.8438rem,0.7098rem_+_0.6696vw,1.3125rem)] text-black no-underline"
>
  <div
    class:list={[
      'card-work-bg relative w-full shrink-0 overflow-hidden rounded-card bg-gray',
      IMAGE_HEIGHT[size],
    ]}
  >
    {image && <img src={image.src} alt={image.alt} class="block size-full object-cover" />}

    <div
      class="card-work-arrow absolute right-[clamp(0.9619rem,0.8092rem_+_0.7634vw,1.4962rem)] bottom-[clamp(0.9619rem,0.8092rem_+_0.7634vw,1.4962rem)] flex size-icon-btn shrink-0 items-center justify-center rounded-full border-[0.0875rem] border-white bg-transparent text-white transition-all duration-200 ease-in-out group-hover/card:bg-white group-hover/card:text-black"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
    </div>
  </div>

  <div class="card-work-body flex flex-col gap-[clamp(0.4219rem,0.3549rem_+_0.3348vw,0.6563rem)]">
    {
      eyebrow && (
        <span class="card-work-eyebrow font-inter text-card-eyebrow leading-[1.5] font-normal tracking-normal text-black capitalize">
          {eyebrow}
        </span>
      )
    }
    <h3 class="card-work-title m-0 font-inter text-card-title leading-[1.4] font-medium tracking-normal text-black">
      {title}
    </h3>
    {
      (clientIcon || clientInitials || clientName) && (
        <div class="card-work-client flex items-center gap-xs">
          {(clientIcon || clientInitials) && (
            <div class="card-work-client-logo flex size-[clamp(1.4962rem,1.9832rem_-_0.5411vw,1.875rem)] shrink-0 items-center justify-center overflow-hidden rounded-full border-[0.0625rem] border-black/20 bg-white">
              {clientIcon ? (
                <img src={clientIcon.src} alt={clientIcon.alt} class="h-auto w-[70%] object-contain" />
              ) : (
                <span class="font-inter text-[clamp(0.3937rem,0.3312rem_+_0.3125vw,0.6125rem)] font-bold text-black">
                  {clientInitials}
                </span>
              )}
            </div>
          )}
          {clientName && (
            <span class="card-work-client-name font-inter text-card-client font-medium text-black capitalize">
              {clientName}
            </span>
          )}
        </div>
      )
    }
  </div>
</a>
