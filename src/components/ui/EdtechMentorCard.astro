---
/**
 * EdTech Mentor Card — 27zero
 * Portado 1:1 de `/components/edtech-mentor-card` del repo vanilla. Sin JS: todo el
 * efecto de hover es CSS puro.
 *
 * Estructura: header transparente (avatar + rol/nombre) + body (la card real, gris,
 * con overlay de gradiente que aparece en hover junto con el título).
 * En mobile no hay hover, así que gradiente, título y flecha quedan en su estado
 * "hover" por default — igual que en el vanilla.
 *
 * Props genéricas, sin acoplar al schema de Sanity (Etapa 5).
 */
interface Props {
  href: string;
  title: string;
  name?: string;
  role?: string;
  tag?: string;
  avatar?: { src: string; alt: string };
  /** Alternativa al avatar: iniciales dentro del círculo. */
  avatarInitials?: string;
}

const { href, title, name, role, tag, avatar, avatarInitials } = Astro.props;
---

<a
  href={href}
  class="card card--edtech-mentor group/card relative flex w-card shrink-0 cursor-pointer flex-col gap-gap overflow-hidden rounded-card bg-transparent text-black no-underline"
>
  <div
    class="card-edtech-mentor-header flex items-center gap-[clamp(0.4838rem,0.407rem_+_0.3839vw,0.7525rem)] bg-transparent p-0"
  >
    {
      (avatar || avatarInitials) && (
        <div class="card-edtech-mentor-avatar flex size-card-avatar shrink-0 items-center justify-center overflow-hidden rounded-full bg-purple">
          {avatar ? (
            <img src={avatar.src} alt={avatar.alt} class="size-full object-cover" />
          ) : (
            <span class="font-inter text-[clamp(0.5231rem,0.4401rem_+_0.4152vw,0.8138rem)] font-bold text-indigo">
              {avatarInitials}
            </span>
          )}
        </div>
      )
    }
    <div class="card-edtech-mentor-meta flex flex-col gap-[clamp(0.0844rem,0.071rem_+_0.067vw,0.1313rem)]">
      {
        role && (
          <span class="card-edtech-mentor-role font-inter text-card-role leading-[1.4] font-medium tracking-normal text-white">
            {role}
          </span>
        )
      }
      {
        name && (
          <span class="card-edtech-mentor-name font-inter text-card-name leading-[1.4] font-medium tracking-normal text-white">
            {name}
          </span>
        )
      }
    </div>
  </div>

  <div
    class="card-edtech-mentor-body relative flex size-card flex-col justify-between overflow-hidden rounded-card bg-gray p-sm after:absolute after:inset-0 after:z-0 after:bg-[linear-gradient(180deg,var(--color-gray)_0%,var(--color-black)_100%)] after:opacity-0 after:transition-opacity after:duration-300 after:ease-in-out after:content-[''] group-hover/card:after:opacity-100 max-md:after:opacity-100"
  >
    {
      tag && (
        <span class="card-edtech-mentor-tag relative z-[1] font-inter text-card-tag leading-[1.5] font-normal tracking-normal text-black">
          {tag}
        </span>
      )
    }

    <div
      class="card-edtech-mentor-footer relative z-[1] flex items-end justify-between gap-[clamp(0.5625rem,0.4732rem_+_0.4464vw,0.875rem)]"
    >
      <h3
        class="card-edtech-mentor-title translate-y-xs font-inter text-card-headline leading-[1.4] font-medium tracking-normal text-white opacity-0 transition-[opacity,transform] duration-300 ease-in-out group-hover/card:translate-y-0 group-hover/card:opacity-100 max-md:translate-y-0 max-md:opacity-100"
      >
        {title}
      </h3>
      <div
        class="card-edtech-mentor-arrow flex size-icon-btn shrink-0 items-center justify-center rounded-full border-[0.125rem] border-black bg-transparent text-black transition-[background-color,color] duration-200 ease-in-out group-hover/card:border-white group-hover/card:text-white max-md:border-white max-md:text-white hover:border-white! hover:bg-white! hover:text-black!"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </div>
    </div>
  </div>
</a>
