---
/**
 * EdTech Mentor Card — 27zero
 * Portado 1:1 de `/components/edtech-mentor-card` del repo vanilla. Sin JS: todo el
 * efecto de hover es CSS puro.
 *
 * Estructura: header transparente (avatar + rol/nombre) + body (la card real, con la
 * `thumbnail` del episodio de fondo — gris si no hay — y overlay de gradiente que
 * aparece en hover junto con el título).
 *
 * El overlay va de `transparent` a `rgba(0,0,0,.75)`: oscurece la mitad inferior para
 * que el título blanco se lea, pero deja ver la `thumbnail` en vez de taparla — antes
 * arrancaba en el gris opaco del design system y borraba la imagen entera.
 *
 * El texto del hover es el TÍTULO DEL EPISODIO (`title`), no el nombre del invitado:
 * ese va en el header, en `name`.
 * En mobile no hay hover, así que gradiente, título y flecha quedan en su estado
 * "hover" por default — igual que en el vanilla.
 *
 * Fade-up del título: la transición declara `opacity,translate`, NO `transform`.
 * Tailwind v4 emite `translate-y-*` sobre la propiedad `translate` (`translate: x y`),
 * no dentro de `transform`, así que `transition-[opacity,transform]` no alcanzaba al
 * desplazamiento: el texto se desvanecía en 300ms pero saltaba de golpe a su posición.
 *
 * `transform-gpu` (título y overlay): el fade del gradiente y el fade-up del título
 * corren en el mismo frame sobre la misma caja. Sin promover ninguno de los dos a capa
 * propia, cada frame del gradiente obliga a re-rasterizar el texto que tiene encima.
 * `translateZ(0)` los separa en capas y el compositor resuelve opacity/translate sin
 * repintar. Es la única razón de esas dos clases.
 *
 * `justify-end`: el header crece hacia ARRIBA, no hacia abajo. `role` es texto libre
 * del CMS y en varias interviews ocupa dos líneas; como el header va antes que el body
 * en un `flex-col`, esa segunda línea empujaba el cuadrado hacia abajo y esa card
 * quedaba desfasada respecto de las de una sola línea — en sliders, grids y modal.
 * Las cards ya se estiran a la altura de la más alta (`align-items: stretch` del track),
 * así que basta con anclar el contenido abajo: el body queda alineado con el del resto y
 * el sobrante cae arriba del header, sobre fondo transparente donde no se ve. Sin
 * truncar el `role` ni cablear una altura fija que se rompa con tres líneas.
 *
 * Props genéricas, sin acoplar al schema de Sanity (Etapa 5).
 */
interface Props {
  href: string;
  title: string;
  name?: string;
  role?: string;
  tag?: string;
  /** Fondo de `.card-edtech-mentor-body` (`edtechMentor.thumbnail`). Sin ella, gris. */
  image?: { src: string; alt: string };
  avatar?: { src: string; alt: string };
  /** Alternativa al avatar: iniciales dentro del círculo. */
  avatarInitials?: string;
}

const { href, title, name, role, tag, image, avatar, avatarInitials } = Astro.props;
---

<a
  href={href}
  class="card card--edtech-mentor group/card relative flex w-card shrink-0 cursor-pointer flex-col justify-end gap-gap rounded-card bg-transparent text-black no-underline"
>
  <div
    class="card-edtech-mentor-header flex items-center gap-[clamp(0.4838rem,0.407rem_+_0.3839vw,0.7525rem)] bg-transparent p-0"
  >
    {
      (avatar || avatarInitials) && (
        <div class="card-edtech-mentor-avatar flex size-card-avatar shrink-0 items-center justify-center overflow-hidden rounded-full bg-purple">
          {avatar ? (
            <img src={avatar.src} alt={avatar.alt} class="size-full object-cover" />
          ) : (
            <span class="font-inter text-[clamp(0.5231rem,0.4401rem_+_0.4152vw,0.8138rem)] font-bold text-indigo">
              {avatarInitials}
            </span>
          )}
        </div>
      )
    }
    <div class="card-edtech-mentor-meta flex flex-col gap-[clamp(0.0844rem,0.071rem_+_0.067vw,0.1313rem)]">
      {
        role && (
          <span class="card-edtech-mentor-role font-inter text-card-role leading-[1.4] font-medium tracking-normal text-white">
            {role}
          </span>
        )
      }
      {
        name && (
          <span class="card-edtech-mentor-name font-inter text-card-name leading-[1.4] font-medium tracking-normal text-white">
            {name}
          </span>
        )
      }
    </div>
  </div>

  <div
    class="card-edtech-mentor-body relative flex size-card flex-col justify-between overflow-hidden rounded-card bg-gray p-sm after:absolute after:inset-0 after:z-0 after:bg-[linear-gradient(180deg,transparent_0%,rgba(0,0,0,0.75)_100%)] after:opacity-0 after:transition-opacity after:duration-300 after:ease-in-out after:content-[''] after:transform-gpu group-hover/card:after:opacity-100 max-md:after:opacity-100"
  >
    {/* Fondo. Va antes que el `::after` en orden de pintado y sin z-index propio, así el
        gradiente de hover queda por encima de la imagen y el contenido (z-1) por encima
        de ambos. Sin `thumbnail` cargada, queda el `bg-gray` del body. */}
    {
      image && (
        <img
          src={image.src}
          alt={image.alt}
          class="card-edtech-mentor-bg absolute inset-0 size-full object-cover"
        />
      )
    }

    {
      tag && (
        <span class="card-edtech-mentor-tag relative z-[1] font-inter text-card-tag leading-[1.5] font-normal tracking-normal text-black">
          {tag}
        </span>
      )
    }

    <div
      class="card-edtech-mentor-footer relative z-[1] mt-auto flex items-end justify-between gap-[clamp(0.5625rem,0.4732rem_+_0.4464vw,0.875rem)]"
    >
      <h3
        class="card-edtech-mentor-title transform-gpu translate-y-xs font-inter text-card-headline leading-[1.4] font-medium tracking-normal text-white opacity-0 transition-[opacity,translate] duration-300 ease-in-out group-hover/card:translate-y-0 group-hover/card:opacity-100 max-md:translate-y-0 max-md:opacity-100"
      >
        {title}
      </h3>
      <div
        class="card-edtech-mentor-arrow flex size-icon-btn shrink-0 items-center justify-center rounded-full border-[0.0625rem] border-black bg-transparent text-black transition-[background-color,border-color,color] duration-200 ease-in-out group-hover/card:border-white group-hover/card:text-white max-md:border-white max-md:text-white hover:border-white! hover:bg-white! hover:text-black!"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </div>
    </div>
  </div>
</a>
