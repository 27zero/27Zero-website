---
/**
 * Practices Card — 27zero
 * Portado 1:1 de `/components/practices-card` del repo vanilla. Sin JS: hover CSS puro.
 *
 * Fondo y tono (ronda 3 de feedback): la card ya no tiene imagen ni overlay. El fondo
 * es `bgColor` y TODO el contenido —texto, CTA, flecha e ícono— sigue a `textColor`,
 * los dos crudos de Sanity y resueltos por `surface()` (`utils/palette`), con fallback
 * dark / light. No se valida contraste: la combinación es decisión del editor.
 *   - Texto `light`: contenido blanco (el tono que antes daba la imagen).
 *   - Texto `dark`: contenido negro (el tono del placeholder del vanilla).
 *
 * El ícono es intercambiable (así está documentado en design-system-components.md):
 * va por `<slot name="icon">`, con el ícono de 3 rombos del vanilla como fallback. Los
 * SVG llegan con `fill="black"` como atributo; en el tono claro los recolorea el CSS
 * del contenedor (`[&_path]:fill-white`), que le gana al atributo de presentación, así
 * que `PracticeIcon` no necesita saber sobre qué fondo va.
 *
 * Texto (feedback Practices, sept 2026): `title` es el titular grande; `name` es el
 * nombre corto de la práctica, en negrita antes del `body` — el peso lo pone el
 * componente, no un marcado dentro del texto. Misma tipografía que el `body` con
 * `font-semibold`, para no sumar un estilo nuevo al design system.
 *
 * `ctaLabel` es opcional: vacío → "Explore the practice", el label genérico de UI que
 * la card usó siempre (CLAUDE.md §4).
 *
 * La flecha invierte sus colores en hover y también en foco de teclado
 * (`group-focus-visible`), para que el estado activo se vea igual con mouse que con Tab.
 *
 * Props genéricas, sin acoplar al schema de Sanity (Etapa 5).
 */
import { surface } from '../../lib/utils/palette';

interface Props {
  href: string;
  title: string;
  name?: string;
  body?: string;
  ctaLabel?: string;
  /** Valor crudo de `bgColor`. Vacío o desconocido → dark. */
  bgColor?: string | null;
  /** Valor crudo de `textColor`. Vacío o desconocido → light. */
  textColor?: string | null;
}

const { href, title, name, body, ctaLabel, bgColor, textColor } = Astro.props;

const { bg: BG_COLOR, text: TEXT_COLOR, tone } = surface(bgColor, textColor);
const isLightText = tone === 'light';

const TEXT_SM = 'font-inter text-body-sm leading-[1.6] tracking-normal';

const ICON_COLOR = isLightText ? '[&_path]:fill-white' : '';

/* Borde y flecha del color del texto; en hover/foco se rellena y la flecha toma el
   color opuesto. */
const ARROW_COLORS = isLightText
  ? 'border-white text-white group-hover/card:bg-white group-hover/card:text-black group-focus-visible/card:bg-white group-focus-visible/card:text-black'
  : 'border-black text-black group-hover/card:bg-black group-hover/card:text-white group-focus-visible/card:bg-black group-focus-visible/card:text-white';
---

<a
  href={href}
  class:list={[
    'practices-card group/card relative flex w-full cursor-pointer flex-col justify-between gap-[4.5rem] overflow-hidden rounded-card px-[clamp(1.0463rem,0.8802rem_+_0.8304vw,1.6275rem)] py-[clamp(1.6087rem,1.3534rem_+_1.2768vw,2.5025rem)] no-underline',
    BG_COLOR,
    TEXT_COLOR,
  ]}
>
  <div
    class="practices-card-block practices-card-block--intro relative z-[1] flex flex-col gap-[clamp(2.4131rem,2.0301rem_+_1.9152vw,3.7538rem)]"
  >
    <div
      class:list={[
        'practices-card-icon [&_svg]:block [&_svg]:h-[clamp(1.5694rem,1.3203rem_+_1.2455vw,2.4413rem)] [&_svg]:w-[clamp(2.3681rem,1.9922rem_+_1.8795vw,3.6837rem)]',
        ICON_COLOR,
      ]}
    >
      <slot name="icon">
        <svg width="59" height="39" viewBox="0 0 59 39" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path
            d="M38.87 38.86L38.55 24.46C35.42 33.03 28.46 38.75 19.35 38.86L19.06 25.09C15.51 33.29 9.14 38.7 0 38.87V-1.0866e-05C8.93 -0.0700109 15.41 5.42999 19.06 13.54L19.39 0.0299891C28.16 -0.140011 35.55 5.67999 38.5 14.47L38.8 0.00998913C49.45 -0.100011 58.13 8.57999 58.2 19.23C58.27 29.58 50.19 38.58 38.86 38.85L38.87 38.86Z"
            fill="black"></path>
        </svg>
      </slot>
    </div>
    <div class="practices-card-text flex flex-col gap-[clamp(0.3994rem,0.336rem_+_0.317vw,0.6212rem)]">
      <h3
        class:list={[
          'practices-card-title font-lora text-[clamp(0.9619rem,0.8092rem_+_0.7634vw,1.4962rem)] leading-[1.4] font-medium tracking-normal',
          TEXT_COLOR,
        ]}
      >
        {title}
      </h3>
      {name && <p class:list={['practices-card-name font-semibold', TEXT_SM, TEXT_COLOR]}>{name}</p>}
      {body && <p class:list={['practices-card-body font-normal', TEXT_SM, TEXT_COLOR]}>{body}</p>}
    </div>
  </div>

  <div
    class="practices-card-block practices-card-block--cta relative z-[1] flex items-center justify-between gap-[clamp(0.5625rem,0.4732rem_+_0.4464vw,0.875rem)]"
  >
    <span
      class:list={[
        'practices-card-cta-text font-lora text-[clamp(0.6806rem,0.5726rem_+_0.5402vw,1.0587rem)] leading-[1.4] font-medium tracking-normal',
        TEXT_COLOR,
      ]}>{ctaLabel || 'Explore the practice'}</span
    >
    <div
      class:list={[
        'practices-card-arrow flex size-icon-btn shrink-0 items-center justify-center rounded-full border-[0.0875rem] bg-transparent transition-all duration-200 ease-in-out',
        ARROW_COLORS,
      ]}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
    </div>
  </div>
</a>
