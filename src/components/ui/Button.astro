---
/**
 * Button — 27zero
 * Base `.btn` del design system global (design-system.md §4.1) + las variantes
 * que consumen los componentes de la Etapa 3.
 *
 * Solo existen las variantes en uso hoy:
 *  - `nav`     → `.btn-nav`, exclusiva del navbar: outline que hereda la variante
 *                activa del `.nav` (white / black / scrolled) y se rellena en hover.
 *                Depende del `group/nav` del Navbar, igual que en el vanilla, donde
 *                `.btn-nav` se estilaba por descendencia de `.nav--*`.
 *  - `dark`    → `.btn-dark`, fondo negro con texto purple, hover a outline negro.
 *  - `outline` → outline negro fijo sobre fondo transparente, hover relleno negro
 *                con texto blanco. Es el estado que `nav` toma sobre fondo blanco,
 *                pero resuelto sin depender del `group/nav` ni de especificidad
 *                heredada: se usa donde el fondo es siempre claro y el botón no
 *                debe seguir la variante activa del nav (ej. el modal mobile).
 *  - `white`   → `.btn-white`, fondo blanco relleno con borde y texto negros, hover a
 *                fondo negro con texto blanco. Agregada en Etapa 4 (Home la usa en el
 *                hero y en la sección EdTech Mentor).
 *  - `whiteIndigo` → variante de `white` para uso sobre fondo indigo (`.section--main-contact
 *                .btn-white` del vanilla, Contact): mismo fondo/borde blancos, pero
 *                texto indigo en vez de negro. En hover pasa a fondo transparente
 *                (deja ver el indigo de la sección) con texto **blanco**, no indigo
 *                — texto indigo sobre fondo indigo transparente sería invisible; el
 *                vanilla (`contact/style.css` `.section--main-contact .btn-white:hover`)
 *                confirma `color: var(--color-white)` en hover, así que el texto SÍ
 *                cambia de color, igual que `white`, solo que parte de un color base
 *                distinto (indigo en vez de negro).
 *  - `purple`  → `.btn-purple`, fondo purple con texto negro, hover a outline negro
 *                sobre fondo transparente. Agregada en Etapa 4 (Contact la usa en el
 *                submit del formulario).
 *  - `blackWhite` → variante de `dark` para uso sobre fondo purple (`.section--investor-mentor
 *                .btn-white` del vanilla, EdTech Mentor): mismo fondo/borde negros que
 *                `dark`, pero texto blanco por default en vez de purple — sobre fondo
 *                purple, texto purple se perdería casi por completo. En hover pasa a
 *                fondo transparente con texto negro, igual que `dark` (el hover de
 *                ambas coincide; solo cambia el color de texto default).
 *
 * Polimórfico: con `href` renderiza `<a>` (el caso por defecto — nav, CTAs). Sin
 * `href`, renderiza `<button type={type}>` — necesario para el submit real de un
 * `<form>` (Contact), donde un link no cumple la semántica ni dispara el evento
 * `submit`. `type` solo aplica en este segundo caso.
 */
interface Props {
  variant: 'nav' | 'dark' | 'outline' | 'white' | 'whiteIndigo' | 'purple' | 'blackWhite';
  /** Con `href` renderiza `<a>`. Sin `href`, renderiza `<button>` (ver `type`). */
  href?: string;
  /** Solo se usa cuando no hay `href` (renderiza `<button type={type}>`). */
  type?: 'button' | 'submit' | 'reset';
  /** Solo aplica cuando hay `href` (caso `<a>`). */
  target?: '_blank' | '_self' | '_parent' | '_top';
  /** Solo aplica cuando hay `href` (caso `<a>`). */
  rel?: string;
  /**
   * Tamaño de texto. `base` es el `.btn` del design system (fluido, 13→16px).
   * `sm` es el 14px fijo que el vanilla usa para el botón del modal mobile.
   * Va como prop y no como clase suelta del consumidor porque dos utilidades de
   * `font-size` sobre el mismo elemento se resuelven por orden de emisión de
   * Tailwind, no por especificidad: el override perdía en silencio.
   */
  size?: 'base' | 'sm' | 'xs';
  /** Clases extra del contexto de uso (posicionamiento, layout). */
  class?: string;
}

const { href, type = 'button', variant, size = 'base', class: className, target, rel } = Astro.props;

/* Sin font-size: lo aporta SIZES, para que solo haya una utilidad de font-size. */
const BASE =
  'inline-flex cursor-pointer items-center justify-center gap-xs rounded-full border border-solid px-[clamp(0.9562rem,0.8045rem_+_0.7589vw,1.4875rem)] py-[clamp(0.4781rem,0.4022rem_+_0.3795vw,0.7438rem)] text-center font-lora leading-[1.2] font-normal no-underline transition-all duration-200 ease-in-out';

const SIZES = {
  base: 'text-button',
  sm: 'text-[0.875rem]',
  /* 13px fijo del `.toc-cta` de la interna de Resources, que además pisa la familia a
     Inter. Va como `size` y no como clase suelta del consumidor por el mismo motivo que
     el resto: dos utilidades de `font-size` sobre el mismo elemento se resuelven por
     orden de emisión de Tailwind, no por especificidad. */
  xs: 'text-[0.8125rem]',
} as const;

const VARIANTS = {
  nav: 'group-[.nav--white]/nav:border-black group-[.nav--white]/nav:text-black group-[.nav--white]/nav:hover:bg-black group-[.nav--white]/nav:hover:text-white group-[.nav--black]/nav:border-white group-[.nav--black]/nav:text-white group-[.nav--black]/nav:hover:bg-white group-[.nav--black]/nav:hover:text-black group-[.nav--scrolled]/nav:border-white group-[.nav--scrolled]/nav:text-white group-[.nav--scrolled]/nav:hover:bg-white group-[.nav--scrolled]/nav:hover:text-indigo',
  dark: 'border-black bg-black text-purple hover:border-black hover:bg-transparent hover:text-black',
  outline: 'border-black bg-transparent text-black hover:border-black hover:bg-black hover:text-white',
  white: 'border-black bg-white text-black hover:border-black hover:bg-black hover:text-white',
  whiteIndigo: 'border-white bg-white text-indigo hover:border-white hover:bg-transparent hover:text-white',
  purple: 'border-purple bg-purple text-black hover:border-black hover:bg-transparent hover:text-black',
  blackWhite: 'border-black bg-black text-white hover:border-black hover:bg-transparent hover:text-black',
} as const;

const CLASSES = ['btn', `btn-${variant}`, BASE, SIZES[size], VARIANTS[variant], className];
---

{
  href ? (
    <a href={href} target={target} rel={rel} class:list={CLASSES}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={CLASSES}>
      <slot />
    </button>
  )
}
