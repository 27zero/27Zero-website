---
/**
 * Featured Card — 27zero
 * Portado 1:1 de `/components/featured-card` del repo vanilla. Sin JS: hover CSS puro.
 *
 * `width/height: 100%` — el tamaño real lo define el wrapper de cada página donde
 * se usa (mismo patrón que `CardsSlider` con `WorkCard`).
 *
 * Pills (feedback EdTech Mentor, Notas 5.2 y 7.3): `tag` y `season` van como `TagPill`
 * filled con el color del CMS. En el destacado de work de Home no hay color: el pill
 * cae al negro.
 *
 * `variant="spotlight"` (Nota 10.2) — solo el destacado de `/edtech-mentor`:
 *   - `.card-featured-content` (avatar, rol, nombre, título y flecha) +40%;
 *   - texto y flecha claros en vez de oscuros;
 *   - el gradiente del hover de `EdtechMentorCard` queda fijo, no solo en hover;
 *   - en mobile el overlay cubre la imagen entera, para que el texto contraste
 *     sobre cualquier foto.
 * Es una variante y no overrides descendentes desde la página porque toca seis
 * elementos a la vez y cada uno necesita su propio `clamp()` escalado (CLAUDE.md §5:
 * los componentes que escalan llevan variantes explícitas).
 *
 * Props genéricas, sin acoplar al schema de Sanity (Etapa 5).
 */
import TagPill from './TagPill.astro';
import type { CardPill } from '../../types/ui';

interface Props {
  href: string;
  title: string;
  tag?: string;
  /** Color del pill de `tag`. Vacío → negro. */
  tagColor?: string;
  /** Color de texto del pill de `tag` (`mentorCategory.textColor`). Vacío → por contraste. */
  tagTextColor?: string;
  season?: CardPill;
  name?: string;
  role?: string;
  avatar?: { src: string; alt: string };
  /** Alternativa al avatar: iniciales dentro del círculo. */
  avatarInitials?: string;
  /**
   * Fondo de la card. Sin ella queda `bg-gray`, que es el comportamiento previo.
   * Va como `background-image` y no como `<img>`, así que el `alt` no se renderiza
   * en ningún lado — mismo caso que las cards de Contact.
   */
  image?: { src: string; alt: string };
  variant?: 'default' | 'spotlight';
}

const { href, title, tag, tagColor, tagTextColor, season, name, role, avatar, avatarInitials, image, variant = 'default' } = Astro.props;

const spotlight = variant === 'spotlight';

/* Cada par es `default` / `spotlight` (= default × 1.4, extremos mobile y desktop). */
const SIZES = spotlight
  ? {
      metaGap: 'gap-[clamp(0.6773rem,0.5698rem_+_0.5375vw,1.0535rem)]',
      avatar: 'size-[clamp(3.675rem,4.5751rem_-_1vw,4.375rem)]',
      initials: 'text-[clamp(0.7323rem,0.6161rem_+_0.5813vw,1.1393rem)]',
      role: 'text-[clamp(0.875rem,0.8275rem_+_0.2374vw,1.0413rem)]',
      name: 'text-[clamp(1.4087rem,1.6225rem_-_0.2374vw,1.575rem)]',
      title: 'max-w-[clamp(22.05rem,18.55rem_+_17.5vw,34.3rem)] text-[clamp(1.1375rem,1.1124rem_+_0.125vw,1.225rem)]',
      arrow: 'size-[clamp(1.9688rem,1.6562rem_+_1.5625vw,3.0625rem)]',
      arrowIcon: 25,
    }
  : {
      metaGap: 'gap-[clamp(0.4838rem,0.407rem_+_0.3839vw,0.7525rem)]',
      avatar: 'size-card-avatar',
      initials: 'text-[clamp(0.5231rem,0.4401rem_+_0.4152vw,0.8138rem)]',
      role: 'text-card-role',
      name: 'text-card-name',
      title: 'max-w-[clamp(15.75rem,13.25rem_+_12.5vw,24.5rem)] text-card-headline',
      arrow: 'size-icon-btn',
      arrowIcon: 18,
    };

const TEXT_COLOR = spotlight ? 'text-white' : 'text-black';

const ARROW_COLORS = spotlight
  ? 'border-white text-white group-hover/card:bg-white group-hover/card:text-black'
  : 'border-black text-black group-hover/card:bg-black group-hover/card:text-white';

/* Mismo gradiente que el hover de `EdtechMentorCard`, fijo. En mobile pasa a un velo
   parejo sobre toda la imagen: ahí el contenido se apila y ocupa mucho más alto que la
   mitad inferior que cubre el gradiente. */
const SPOTLIGHT_OVERLAY =
  "after:pointer-events-none after:absolute after:inset-0 after:z-0 after:bg-[linear-gradient(180deg,transparent_0%,rgba(0,0,0,0.75)_100%)] after:content-[''] max-md:after:bg-black/55";
---

<a
  href={href}
  style={image ? `background-image: url('${image.src}')` : undefined}
  class:list={[
    'card card--featured group/card relative flex size-full shrink-0 cursor-pointer flex-col justify-between overflow-hidden rounded-card bg-gray bg-cover bg-center p-[clamp(0.9562rem,0.8045rem_+_0.7589vw,1.4875rem)] text-black no-underline',
    spotlight && SPOTLIGHT_OVERLAY,
  ]}
>
  {/* `z-[1]` en los dos hijos directos: quedan por encima del overlay `::after` de la
      variante spotlight. En la default no hay overlay y no cambia nada. */}
  {
    (tag || season) && (
      <div class="card-featured-tags relative z-[1] flex flex-wrap items-start gap-xs">
        {tag && <TagPill label={tag} color={tagColor} textColor={tagTextColor} class="card-featured-tag" />}
        {season && <TagPill label={season.label} color={season.color} class="card-featured-season" />}
      </div>
    )
  }

  <div class="card-featured-content relative z-[1] mt-auto flex flex-col gap-sm max-md:gap-[3.6563rem]">
    <div class:list={['card-featured-meta flex items-center', SIZES.metaGap]}>
      {
        (avatar || avatarInitials) && (
          <div class:list={['card-featured-avatar flex shrink-0 items-center justify-center overflow-hidden rounded-full bg-purple', SIZES.avatar]}>
            {avatar ? (
              <img src={avatar.src} alt={avatar.alt} class="size-full object-cover" />
            ) : (
              <span class:list={['font-inter font-bold text-indigo', SIZES.initials]}>
                {avatarInitials}
              </span>
            )}
          </div>
        )
      }
      <div class="card-featured-meta-text flex flex-col gap-[clamp(0.0844rem,0.071rem_+_0.067vw,0.1313rem)]">
        {
          role && (
            <span class:list={['card-featured-role font-inter leading-[1.4] font-medium tracking-normal', SIZES.role, TEXT_COLOR]}>
              {role}
            </span>
          )
        }
        {
          name && (
            <span class:list={['card-featured-name font-inter leading-[1.4] font-medium tracking-normal', SIZES.name, TEXT_COLOR]}>
              {name}
            </span>
          )
        }
      </div>
    </div>

    <div class="card-featured-footer flex items-end justify-between gap-sm max-md:flex-col max-md:items-start">
      <h3
        class:list={[
          'card-featured-title font-lora leading-[1.4] font-medium tracking-normal max-md:max-w-full',
          SIZES.title,
          TEXT_COLOR,
        ]}
      >
        {title}
      </h3>
      <div
        class:list={[
          'card-featured-arrow flex shrink-0 items-center justify-center rounded-full border-[0.0875rem] bg-transparent transition-all duration-200 ease-in-out',
          SIZES.arrow,
          ARROW_COLORS,
        ]}
      >
        <svg width={SIZES.arrowIcon} height={SIZES.arrowIcon} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </div>
    </div>
  </div>
</a>
