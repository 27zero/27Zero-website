---
/**
 * Clientes — 27zero
 * Portado 1:1 de `/clientes/index.html` + `/clientes/style.css` del repo vanilla.
 * Clases propias documentadas en `/clientes/design-system-clientes.md`.
 *
 * Misma plantilla que Work (`FilterPills` + `CategorySliders`, sin modificar): la
 * única diferencia real es el criterio de agrupación de los `work` — por cliente en
 * vez de por categoría de servicio — y por lo tanto los labels de pills y sliders.
 *
 * Dos diferencias puntuales contra Work:
 *  - No hay grupo "Los mejores", así que tampoco el override de altura de card que
 *    Work aplica sobre esa sección. `clientes/style.css` conserva la regla
 *    `#los-mejores .card--work` heredada del copy-paste de Work, pero es CSS muerto
 *    (no existe ese anchor en esta página) y no se replica.
 *  - Los 8 clientes llevan pill; en Work, "Los mejores" quedaba fuera del filtro.
 *
 * El hero repite el markup de Work en vez de extraerse a un componente: el copy real
 * de esta página está pendiente (ver abajo), así que los dos heros van a divergir en
 * cuanto llegue. Extraerlo ahora sería abstraer sobre contenido provisorio.
 *
 * Valores fluidos con la curva del resto del proyecto: mobile = `em × 9` @320px,
 * desktop = `em × 14` @1440px, salvo donde el vanilla fija un valor mobile propio.
 */
import Page from '../layouts/Page.astro';
import CategorySliders from '../components/sections/CategorySliders.astro';
import FilterPills from '../components/sections/FilterPills.astro';
import MarqueeLogos from '../components/sections/MarqueeLogos.astro';
import { WORK_BY_CLIENT, WORK_FILTER_CLIENTS } from '../lib/mockData/workByClient';

/* `.container` con el `padding-left` propio del hero/pills (13em desktop, 2em mobile).
   Va como `pl-` + `pr-container-x` y no `px-container-x` + `pl-`: dos utilidades sobre
   el mismo `padding-left` se resuelven por orden de emisión de Tailwind, no por el
   orden del atributo `class`, y el override perdería en silencio. */
const HERO_CONTAINER =
  'container mx-auto flex w-full max-w-(--container-max-width) flex-col pr-container-x pl-[clamp(1.125rem,-1.8036rem_+_14.6429vw,11.375rem)]';
---

<Page title="Clientes — 27zero" navVariant="white">
  {/* PENDIENTE (planning-maquetado-clientes.md #1): el hero del vanilla quedó con el
      copy literal de la página Work (eyebrow, h1 y párrafo sin editar) —
      `design-system-clientes.md` lo confirma como copy-paste. Se replica tal cual, sin
      inventar copy nuevo ni placeholder propio: es contenido provisorio a la espera del
      copy real de Clientes. */}
  <!-- HERO -->
  <section
    class="section section--hero pt-[clamp(10.2431rem,8.6172rem_+_8.1295vw,15.9337rem)] pb-[clamp(2.8125rem,2.3661rem_+_2.2321vw,4.375rem)]"
  >
    <div class:list={[HERO_CONTAINER, 'hero-container gap-xs']}>
      <span
        class="text-eyebrow block font-inter text-[clamp(0.7256rem,0.6104rem_+_0.5759vw,1.1288rem)] leading-[1.6] font-normal tracking-normal text-black"
      >
        Work: Behind the fastest-growing EdTech brands
      </span>
      <h1 class="font-lora text-h1 leading-[1.25] font-medium tracking-[clamp(-0.03rem,0.0013rem_-_0.0348vw,-0.0056rem)]">
        Behind the fastest growing EdTech brands.
      </h1>
      <p class="text-body font-inter text-body leading-[1.6] font-medium tracking-normal">
        First-hand expertise, innovative conceptual thinking &amp; design, client-first approach
      </p>
    </div>
  </section>

  <!-- FILTER PILLS -->
  <FilterPills categories={WORK_FILTER_CLIENTS} />

  <!-- MARQUEE LOGOS -->
  <section class="section section--marquee pt-0 pb-[clamp(4.0162rem,3.3787rem_+_3.1875vw,6.2475rem)]">
    <MarqueeLogos />
  </section>

  <!-- CATEGORY SLIDERS (agrupados por cliente) -->
  <CategorySliders categories={WORK_BY_CLIENT} />
</Page>
