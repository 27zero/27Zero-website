---
/**
 * Work — interna de un case study — 27zero
 * Portado de `/work-cms/index.html` + `/work-cms/style.css` del repo vanilla y
 * reorganizado en el feedback de Work (astro-changes-work.md). Plantilla compartida por
 * Work y Clientes: los dos listados son el mismo `documentType` con distinto criterio de
 * agrupación, y los dos linkean acá vía `workUrl()`.
 *
 * Orden de la página (Nota 7.3 — el mismo del fieldset `narrative` del Studio):
 *
 *   Hero (título, subtítulo, video o imagen) → Cliente → Results
 *   → Business Problem → Communication Challenge → Strategic Idea
 *   → Client's feedback (slider) → Additional Sections → Final CTA
 *
 * Cada sección se omite entera si no tiene contenido. Colores de la narrativa: purple /
 * white / indigo, y el slider de testimonios sobre negro — ver `NARRATIVE_THEMES`.
 *
 * Ronda 2 (astro-changes-work-r2.md): el título público es `headline` (`title` es el
 * nombre interno y solo queda de respaldo), las imágenes salen responsive desde la caja
 * donde se ven (§1), los colores de sección son nombres de la paleta (§4) y el Final CTA
 * es un documento `cta` referenciado (§5).
 *
 * Valores fluidos con la curva del proyecto: mobile = `em × 9` @320px,
 * desktop = `em × 14` @1440px.
 */
import Page from '../../layouts/Page.astro';
import CaseStudyBlock from '../../components/sections/CaseStudyBlock.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import TestimonialsSlider from '../../components/sections/TestimonialsSlider.astro';
import { practiceNames, testimonialAvatar, workCardTitle, type TestimonialProjection } from '../../lib/sanity/cards';
import { sanityClient } from '../../lib/sanity/client';
import { imgAttrs, toImage } from '../../lib/sanity/image';
import { workDetailQuery } from '../../lib/sanity/queries';
import { getSeoSettings } from '../../lib/sanity/settings';
import { ogTypeFor } from '../../lib/seo/ogType';
import { resolveSeo } from '../../lib/seo/resolveSeo';
import { paletteSurface } from '../../lib/utils/color';
import { truncateAtWord } from '../../lib/utils/format';
import { caseStudyBox, caseStudyImageHeight, IMAGE_BOXES } from '../../lib/utils/imageBoxes';
import { hasContent } from '../../lib/utils/portableText';
import { detailTrail } from '../../lib/utils/breadcrumbs';
import { toStaticPaths } from '../../lib/utils/routes';
import { toVideoEmbed } from '../../lib/utils/video';
import type { Cta, ImageHeightVariant, PortableTextBlock, SanityImage, Seo, Work } from '../../types/sanity';

/** Imagen con `caption` opcional (galería y arrays de imágenes del Case Study). */
type CaptionedImage = SanityImage & { caption?: string };

export interface WorkDetail {
  _id: string;
  title?: string;
  subtitle?: string;
  slug?: string;
  seo?: Seo;
  /** Título público (`h1`). Requerido en el schema; hay documentos sin cargar todavía. */
  headline?: string;
  briefParagraph?: string;
  /** `projectType[]->practiceName`. Referencias sin publicar llegan `null`. */
  practices?: (string | null)[] | null;
  agencyRole?: string;
  year?: number;
  location?: string;
  thumbnail?: SanityImage;
  heroImage?: SanityImage;
  heroVideo?: string;
  gallery?: CaptionedImage[];
  /** GROQ devuelve `null` (no `undefined`) para un campo vacío. */
  galleryHeightVariant?: ImageHeightVariant | null;
  galleryCustomHeight?: number | null;
  results?: { _key: string; number?: string; description?: string }[];
  client?: { _id: string; name?: string; url?: string; logo?: SanityImage };
  challenge?: Work['challenge'];
  communicationChallenge?: Work['communicationChallenge'];
  solution?: Work['solution'];
  contentSections?: Work['contentSections'];
  /** `cta->` expandido: sin referencia (o a un documento sin publicar) llega `null`. */
  cta?: Pick<Cta, 'headline' | 'bodyText' | 'ctaText' | 'ctaLink' | 'bgColor' | 'headlineColor' | 'bodyTextColor'> | null;
  testimonials?: TestimonialProjection[];
}

export async function getStaticPaths() {
  const works = await sanityClient.fetch<WorkDetail[]>(workDetailQuery);
  return toStaticPaths(works, { label: 'work/[slug]', slugOf: (w) => w.slug });
}

const work = Astro.props as WorkDetail;

/* El `seo` del documento manda. Si el editor no lo cargó, title y description salen del
   propio contenido — sigue siendo la misma fuente (el documento), no una segunda — y
   recién después cae al fallback global de `settings`.

   Meta title (ronda 2, §2): `seo.title`; si no, `headline` — el título público —, con
   `title` de respaldo mientras haya documentos sin `headline`.

   Meta description (Nota 4): `seo.description` si está cargada; si no, `briefParagraph`
   recortado a 160 caracteres en el render, sin cortar una palabra al medio (CLAUDE.md
   §8.1). */
const siteSettings = await getSeoSettings();

/** `headline`, o `title` si todavía no está cargado. Lo usan el `h1`, el SEO y la miga. */
const headline = workCardTitle(work) || 'Work';

const breadcrumb = detailTrail('work', { label: headline });

const seo = {
  ...resolveSeo(work.seo),
  title: work.seo?.title ?? `${headline} — 27zero`,
  description: work.seo?.description ?? truncateAtWord(work.briefParagraph, 160),
};

/* ─────────────────────────────── Hero ───────────────────────────────── */

/* Nota 10: `heroVideo` (YouTube o Vimeo) reemplaza a la imagen cuando está cargado y
   se reconoce. Una URL que no es de ninguno de los dos cae a la imagen. */
const heroVideo = toVideoEmbed(work.heroVideo);
const heroImage = heroVideo ? undefined : toImage(work.heroImage ?? work.thumbnail, { box: IMAGE_BOXES.workHero });

/* ────────────────────────────── Cliente ─────────────────────────────── */

/* Notas 3.3 y 3.4: una sola fuente, `client.logo` (`work.clientLogo` se eliminó). El
   schema de `client.logo` no tiene campo `alt`, y `toImage()` descarta toda imagen sin
   `alt` — así el logo no se vería nunca. Para un logo el texto alternativo correcto es
   el nombre de la marca, así que se deriva de `client.name`. Guard defensivo: sin
   cliente o sin logo, no hay imagen. */
const clientLogo =
  work.client?.logo && work.client.name
    ? toImage({ ...work.client.logo, alt: work.client.logo.alt ?? `${work.client.name} logo` }, { box: IMAGE_BOXES.clientLogo })
    : undefined;

/* Notas 6.2 y 6.3: los 4 campos de la tab "Project Brief". "Contribution" se eliminó
   del schema. "Project Type" son las practices del proyecto separadas por ", "
   (feedback 2026-10-09); sin ninguna, el filtro saca el ítem con su label. */
const details: { label: string; value?: string }[] = [
  { label: 'Project Type', value: practiceNames(work.practices).join(', ') },
  { label: 'Agency Role', value: work.agencyRole },
  { label: 'Location', value: work.location },
  { label: 'Year', value: work.year ? String(work.year) : undefined },
].filter((detail) => detail.value?.trim());

/* ───────────────────────────── Results ──────────────────────────────── */

const results = (work.results ?? []).filter((r) => r.number || r.description);

/** Una imagen que `toImage()` va a resolver: con asset y con `alt` (CLAUDE.md §8.1). */
function isRenderable(image: SanityImage | null | undefined): boolean {
  return Boolean(image?.asset?._ref && image.alt);
}

/* Nota 10: la galería de Results muestra el `caption` de cada imagen debajo de ella.
   La caja depende de cuántas columnas ocupa la grilla, así que se cuentan antes las
   imágenes que se van a renderizar (con asset y `alt`).

   Alto (feedback 2026-10-09): `galleryHeightVariant` / `galleryCustomHeight` con el mismo
   mecanismo que las secciones del Case Study (`CaseStudyBlock`) — mismo cálculo, misma
   caja y mismas clases: alto fijo con `object-cover` en desktop, 1 columna sin recorte
   en mobile. Vacío → `medium`, el `initialValue` del schema. */
const galleryHeight = caseStudyImageHeight(work.galleryHeightVariant, work.galleryCustomHeight);
const galleryColumns = Math.min(4, (work.gallery ?? []).filter(isRenderable).length);
const galleryImages = (work.gallery ?? []).flatMap((image) => {
  const resolved = toImage(image, { box: caseStudyBox(galleryColumns, galleryHeight.at) });
  return resolved ? [{ ...resolved, caption: image.caption?.trim() }] : [];
});

/* ───────────────────────────── Narrativa ────────────────────────────── */

interface ContentBlock {
  key: string;
  title?: string;
  /** Solo Strategic Idea: el headline va como bajada destacada arriba del cuerpo. */
  lead?: string;
  /** Portable Text en la narrativa; `string` plano en `contentSections`. */
  content?: PortableTextBlock[] | string;
  images?: SanityImage[] | null;
  heightVariant?: ImageHeightVariant | null;
  customHeight?: number | null;
}

/**
 * Colores de la narrativa. Challenge abre en purple (el color del primer bloque en el
 * vanilla), Communication Challenge en blanco y Strategic Idea en indigo: así ninguna
 * sección queda pegada a otra del mismo fondo — Results arriba es blanca y el slider de
 * testimonios abajo es negro.
 */
const NARRATIVE_THEMES = {
  purple: { section: 'bg-purple', text: 'text-black' },
  white: { section: 'bg-white', text: 'text-black' },
  indigo: { section: 'bg-indigo', text: 'text-white' },
} as const;

/* El label de cada sección es editable por proyecto (ej. "RFP Brief"). Vacío — pasa en
   documentos anteriores al campo, porque el `initialValue` solo aplica a los nuevos —
   cae al nombre estándar de la sección. */
const narrative: { block: ContentBlock; theme: keyof typeof NARRATIVE_THEMES }[] = [
  {
    block: {
      key: 'challenge',
      title: work.challenge?.challengeTitle?.trim() || 'Business Problem',
      content: work.challenge?.challengeContent,
      images: work.challenge?.challengeImages,
      heightVariant: work.challenge?.heightVariant,
      customHeight: work.challenge?.customHeight,
    },
    theme: 'purple',
  },
  {
    block: {
      key: 'communication-challenge',
      title: work.communicationChallenge?.sectionLabel?.trim() || 'Communication Challenge',
      content: work.communicationChallenge?.content,
      images: work.communicationChallenge?.images,
      heightVariant: work.communicationChallenge?.heightVariant,
      customHeight: work.communicationChallenge?.customHeight,
    },
    theme: 'white',
  },
  {
    block: {
      key: 'strategic-idea',
      title: work.solution?.sectionLabel?.trim() || 'Strategic Idea',
      lead: work.solution?.headline?.trim(),
      content: work.solution?.body,
      images: work.solution?.solutionImages,
      heightVariant: work.solution?.heightVariant,
      customHeight: work.solution?.customHeight,
    },
    theme: 'indigo',
  },
];

/* Un bloque sin cuerpo, bajada ni imágenes se omite: el label solo, con su default, no
   es contenido. */
const hasBody = (block: ContentBlock) =>
  Boolean(block.lead) ||
  (typeof block.content === 'string' ? Boolean(block.content.trim()) : hasContent(block.content)) ||
  (block.images ?? []).some(isRenderable);

const narrativeBlocks = narrative.filter(({ block }) => hasBody(block));

/* Nota 7.7: cada Additional Section trae su fondo y su texto, nombres de la paleta de
   marca desde la ronda 2 (§4). Fondo vacío → blanco; texto vacío → negro o blanco según
   el fondo. */
const additionalSections = (work.contentSections ?? [])
  .map((section) => ({
    block: {
      key: section._key,
      title: section.title?.trim(),
      content: section.body,
      images: section.images,
      heightVariant: section.heightVariant,
      customHeight: section.customHeight,
    } satisfies ContentBlock,
    colors: paletteSurface(section.bgColor, section.textColor, 'white'),
  }))
  .filter(({ block }) => block.title || hasBody(block));

const testimonials = (work.testimonials ?? [])
  .filter((testimonial) => testimonial.quote && testimonial.authorName)
  .map((testimonial) => ({
    quote: testimonial.quote,
    authorName: testimonial.authorName!,
    authorRole: testimonial.authorRole,
    avatarPhoto: testimonialAvatar(testimonial),
  }));

/* ───────────────────────────── Imágenes ─────────────────────────────── */

/* Columnas de la grilla de la galería de Results según cuántas imágenes hay (las de la
   narrativa las resuelve `CaseStudyBlock`, con el mismo criterio). */
const gridCols = (count: number) =>
  count === 1 ? 'grid-cols-1' : count === 3 ? 'grid-cols-3' : count >= 4 ? 'grid-cols-4' : 'grid-cols-2';

/* ─────────────────────────────── Clases ─────────────────────────────── */

const CONTAINER =
  'container mx-auto flex w-full max-w-(--container-max-width) flex-col gap-[clamp(2.2106rem,1.8597rem_+_1.7545vw,3.4388rem)] px-container-x max-md:gap-[clamp(1.9688rem,1.6563rem_+_1.5625vw,3.0625rem)]';

const SECTION_Y = 'py-[clamp(5.0231rem,4.2258rem_+_3.9866vw,7.8137rem)]';
const IMAGE_GAP = 'gap-[clamp(0.6019rem,0.5063rem_+_0.4777vw,0.9363rem)]';
const IMAGE_RADIUS = 'rounded-[0.57em] object-cover w-full';
const EYEBROW = 'block font-inter text-[clamp(0.5rem,0.4286rem_+_0.3571vw,0.75rem)] leading-[1.5] font-normal capitalize';
---

<Page seo={seo} siteSettings={siteSettings} breadcrumb={breadcrumb} ogType={ogTypeFor('work')} navVariant="white">
  <!-- 1. HERO -->
  <section
    class="section section--hero pt-[clamp(6.75rem,5.6786rem_+_5.3571vw,10.5rem)] pb-[clamp(2.2106rem,1.8597rem_+_1.7545vw,3.4388rem)]"
  >
    <div class={CONTAINER}>
      {/* Nota 4: el `h1` ocupa hasta el 75% del ancho en desktop y el 100% en mobile; el
          subtítulo va inmediatamente debajo, por eso comparten un wrapper con su propio
          gap en vez de heredar el del container. */}
      <div class="flex flex-col gap-sm">
        <h1
          class="max-w-[75%] font-lora text-h1 leading-[1.25] font-medium tracking-[clamp(-0.02rem,-0.0171rem_-_0.0143vw,-0.03rem)] max-md:max-w-full"
        >
          {headline}
        </h1>
        {
          work.subtitle && (
            <p class="max-w-[75%] font-inter text-body leading-[1.6] font-medium tracking-normal text-black max-md:max-w-full">
              {work.subtitle}
            </p>
          )
        }
      </div>

      {
        heroVideo ? (
          <div class="aspect-video w-full overflow-hidden rounded-[0.57em] bg-black">
            <iframe
              src={heroVideo.src}
              title={`${headline} — video`}
              class="size-full border-0"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </div>
        ) : (
          heroImage && (
            <img
              {...imgAttrs(heroImage)}
              class:list={[IMAGE_RADIUS, 'h-[clamp(21.375rem,17.9821rem_+_16.9643vw,33.25rem)]']}
            />
          )
        )
      }
    </div>
  </section>

  <!-- 2. CLIENTE -->
  <section class="section section--client pt-0 pb-[clamp(2.2106rem,1.8597rem_+_1.7545vw,3.4388rem)]">
    <div class={CONTAINER}>
      <div
        class="client-block grid grid-cols-[1fr_1.6fr] items-start gap-[clamp(3.375rem,2.8393rem_+_2.6786vw,5.25rem)] max-md:grid-cols-1 max-md:gap-[clamp(1.9688rem,1.6563rem_+_1.5625vw,3.0625rem)]"
      >
        <div class="client-meta flex flex-col gap-[clamp(2.4131rem,2.0301rem_+_1.9152vw,3.7538rem)]">
          <div class="client-logo-wrap flex flex-col items-start gap-sm">
            {/* Logo completo de la marca, en su proporción, con 70px de alto máximo. */}
            {
              clientLogo && (
                <img
                  {...imgAttrs(clientLogo)}
                  class="block h-auto max-h-[4.375rem] w-auto max-w-full object-contain"
                />
              )
            }
            {/* Sin tagline debajo: `clientTagline` pasó a ser `headline` (ronda 2), que ya
                es el `h1` de la página. */}
            <div class="client-name-wrap flex flex-col gap-[clamp(0.1125rem,0.0946rem_+_0.0893vw,0.175rem)]">
              <span class="font-inter text-[clamp(0.75rem,0.6429rem_+_0.5357vw,1.125rem)] font-bold text-black">
                {work.client?.name}
              </span>
            </div>
          </div>

          {
            details.length > 0 && (
              <dl class="client-details grid grid-cols-2 gap-sm">
                {details.map((detail) => (
                  <div class="client-detail-group flex flex-col gap-xs">
                    <dt class="font-inter text-[clamp(0.4375rem,0.3661rem_+_0.3571vw,0.6875rem)] font-medium tracking-[0.03125rem] text-black/40 uppercase">
                      {detail.label}
                    </dt>
                    <dd class="font-inter text-[clamp(0.5625rem,0.4732rem_+_0.4464vw,0.875rem)] leading-[1.5] font-normal text-black">
                      {detail.value}
                    </dd>
                  </div>
                ))}
              </dl>
            )
          }
        </div>

        {/* Nota 6.4: un solo párrafo, `briefParagraph` (antes `brief` + `excerpt`). */}
        {
          work.briefParagraph && (
            <div class="client-content flex flex-col gap-sm">
              <p class="font-inter text-body-article leading-[1.6] font-normal whitespace-pre-line text-black">
                {work.briefParagraph}
              </p>
            </div>
          )
        }
      </div>

      <hr class="w-full border-0 border-t border-solid border-black/15" />
    </div>
  </section>

  <!-- 3. RESULTS -->
  {
    (results.length > 0 || galleryImages.length > 0) && (
      <section class="section section--results pt-0 pb-[clamp(5.0231rem,4.2258rem_+_3.9866vw,7.8137rem)]">
        <div class={CONTAINER}>
          <span class:list={[EYEBROW, 'text-black']}>Results</span>

          {results.length > 0 && (
            <div class="stats-grid grid grid-cols-4 gap-[clamp(3.015rem,2.5364rem_+_2.3929vw,4.69rem)] max-md:grid-cols-2 max-md:gap-[clamp(1.9688rem,1.6563rem_+_1.5625vw,3.0625rem)]">
              {results.map((result) => (
                <div class="stat flex flex-col gap-[clamp(0.4219rem,0.3549rem_+_0.3348vw,0.6563rem)]">
                  <span class="font-lora text-[clamp(1.9375rem,1.6339rem_+_1.5179vw,3rem)] leading-[1.25] font-medium tracking-[-0.48px] text-black">
                    {result.number}
                  </span>
                  <p class="font-inter text-body-article leading-[1.6] font-normal text-black">
                    {result.description}
                  </p>
                </div>
              ))}
            </div>
          )}

          {galleryImages.length > 0 && (
            <div
              class:list={['grid', gridCols(galleryImages.length), IMAGE_GAP, 'max-md:grid-cols-1']}
              style={`--image-height:${galleryHeight.css}`}
            >
              {galleryImages.map((image) => (
                <figure class="flex flex-col gap-xs">
                  <img
                    {...imgAttrs(image)}
                    class:list={[IMAGE_RADIUS, 'h-(--image-height) max-md:h-auto max-md:object-contain']}
                    loading="lazy"
                  />
                  {image.caption && (
                    <figcaption class="font-inter text-body-sm leading-[1.5] font-normal text-black/60">
                      {image.caption}
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- 4–6. NARRATIVA — Business Problem / Communication Challenge / Strategic Idea -->
  {
    narrativeBlocks.map(({ block, theme }) => (
      <section
        class:list={['section', `section--${block.key}`, NARRATIVE_THEMES[theme].section, NARRATIVE_THEMES[theme].text, SECTION_Y]}
      >
        <div class={CONTAINER}>
          <CaseStudyBlock {...block} />
        </div>
      </section>
    ))
  }

  <!-- 7. CLIENT'S FEEDBACK — Nota 7.2: todos los testimonios linkeados, en slider -->
  {/* El label queda hardcodeado: el `sectionLabel` de `clientQuote` se eliminó del
      schema junto con el campo. */}
  {testimonials.length > 0 && <TestimonialsSlider testimonials={testimonials} label="Client's feedback" />}

  <!-- 8. ADDITIONAL SECTIONS — Nota 7.7: fondo y texto del CMS -->
  {
    additionalSections.map(({ block, colors }) => (
      <section
        class:list={['section section--additional bg-(--section-bg) text-(--section-text)', SECTION_Y]}
        style={`--section-bg:${colors.background};--section-text:${colors.text}`}
      >
        <div class={CONTAINER}>
          <CaseStudyBlock {...block} />
        </div>
      </section>
    ))
  }

  <!-- 9. FINAL CTA — Nota 7.9 -->
  {/* Documento `cta` referenciado desde la ronda 2 (§5). Sin referencia, sin sección. */}
  {work.cta && <FinalCta {...work.cta} />}
</Page>
