---
/**
 * Work — 27zero
 * Portado 1:1 de `/work/index.html` + `/work/style.css` del repo vanilla.
 * Clases propias documentadas en `/work/design-system-work.md`.
 *
 * Página estática en su armado: la estructura (hero, pills, marquee, 8 sliders por
 * categoría) nunca cambia; lo que en Etapa 6 pasa a GROQ es el contenido de las cards.
 *
 * El grueso de la página vive en dos componentes de `sections/` — `FilterPills` y
 * `CategorySliders` — porque Clientes reutiliza exactamente el mismo markup con otro
 * criterio de agrupación (por cliente en vez de por categoría de servicio). Acá solo
 * queda el hero y el ensamblado.
 *
 * Valores fluidos con la curva del resto del proyecto: mobile = `em × 9` @320px,
 * desktop = `em × 14` @1440px, salvo donde el vanilla fija un valor mobile propio en
 * su `@media (max-width: 768px)` — ahí el `clamp()` usa los px reales de cada extremo.
 */
import Page from '../layouts/Page.astro';
import { getPageSeo } from '../lib/sanity/settings';
import CategorySliders from '../components/sections/CategorySliders.astro';
import FilterPills from '../components/sections/FilterPills.astro';
import MarqueeLogos from '../components/sections/MarqueeLogos.astro';
import { featuredWorksOf, toWorkCard } from '../lib/sanity/cards';
import { IMAGE_BOXES } from '../lib/utils/imageBoxes';
import type { FeaturedWorkCategoryProjection, WorkCardProjection } from '../lib/sanity/cards';
import { sanityClient } from '../lib/sanity/client';
import { workListQuery } from '../lib/sanity/queries';
import { SHOW_WORK_SLIDERS } from '../lib/utils/displayFlags';
import WorkCard from '../components/ui/WorkCard.astro';
import type { WorkGroup } from '../types/ui';

const { featuredCategories, categories, works, hero } = await sanityClient.fetch<{
  featuredCategories: FeaturedWorkCategoryProjection[];
  categories: { _id: string; title: string; slug: string }[];
  works: WorkCardProjection[];
  hero: { eyebrow?: string; headline?: string; subtitle?: string } | null;
}>(workListQuery);

/* Sliders destacados, arriba de todo (feedback Work, Nota 9). Reemplazan al bloque fijo
   "Los mejores": uno por cada `workCategory` con `isFeaturedCategory`, en su `order`,
   con su selección curada (`featuredWorks`) y las cards en su variante alta.

   El `id` lleva el prefijo `featured-` porque la misma categoría tiene además su slider
   normal más abajo, con el slug como `id` (destino de su pill). Sin prefijo habría dos
   anchors con el mismo `id`. Los destacados no llevan pill, igual que "Los mejores". */
const FEATURED_GROUPS: WorkGroup[] = featuredCategories.flatMap((category) => {
  const items = featuredWorksOf(category).map((work) => toWorkCard(work, { box: IMAGE_BOXES.cardTall }));

  return items.length > 0
    ? [{ id: `featured-${category.slug}`, label: category.title, items, cardSize: 'tall' as const }]
    : [];
});

/* Un grupo por categoría. Las categorías sin ningún `work` no se renderizan: dejarlas
   daría un slider vacío y un pill que scrollea a un anchor sin contenido. El orden es
   el `order` del Studio. */
const CATEGORY_GROUPS: WorkGroup[] = categories.flatMap((category) => {
  const items = works.filter((work) => work.categorySlug === category.slug).map((work) => toWorkCard(work));

  return items.length > 0 ? [{ id: category.slug, label: category.title, items }] : [];
});

const WORK_BY_CATEGORY: WorkGroup[] = [...FEATURED_GROUPS, ...CATEGORY_GROUPS];

/* Los pills salen de las categorías normales, sin los destacados — mismo criterio que
   "Los mejores" en el vanilla (el "All" lo antepone `FilterPills`). Derivarlos de los
   mismos grupos garantiza que todo pill apunte a un anchor existente. */
const WORK_FILTER_CATEGORIES = CATEGORY_GROUPS.map(({ id, label }) => ({ id, label }));

/* Grilla que reemplaza a los sliders mientras `SHOW_WORK_SLIDERS` es `false` (feedback
   2026-10-09). Fix temporal (ronda 2): un bloque por categoría, con su título y su
   anchor, en el `order` de las categorías — cada work aparece una sola vez, en la suya,
   en el orden de `works` (`order asc, title asc`). Los pills scrollean al bloque con el
   mismo JS que usaban con los sliders: el `id` del bloque es el slug de su pill. */
const GRID_GROUPS: WorkGroup[] = categories.flatMap((category) => {
  const items = works
    .filter((work) => work.categorySlug === category.slug)
    .map((work) => toWorkCard(work, { box: IMAGE_BOXES.cardGrid }));

  return items.length > 0 ? [{ id: category.slug, label: category.title, items }] : [];
});

/* `.container` con el `padding-left` propio del hero/pills de Work (13em desktop,
   2em mobile — el doble de la indentación del container base en desktop). Va como
   `pl-` + `pr-container-x` en vez de `px-container-x` + `pl-`: dos utilidades sobre
   el mismo `padding-left` se resuelven por orden de emisión de Tailwind, no por el
   orden del atributo `class`, y el override perdería en silencio. */
const HERO_CONTAINER =
  'container mx-auto flex w-full max-w-(--container-max-width) flex-col pr-container-x pl-[clamp(1.125rem,-1.8036rem_+_14.6429vw,11.375rem)]';

/* SEO de esta página: `settings.workSeo` en Sanity, con fallback global.
   `getPageSeo()` memoiza el singleton — una sola query para todo el build. */
const { seo, siteSettings } = await getPageSeo('work');
---

<Page seo={seo} siteSettings={siteSettings} navVariant="white">
  <!-- HERO -->
  <section
    class="section section--hero pt-[clamp(10.2431rem,8.6172rem_+_8.1295vw,15.9337rem)] pb-[clamp(2.8125rem,2.3661rem_+_2.2321vw,4.375rem)]"
  >
    <div class:list={[HERO_CONTAINER, 'hero-container gap-xs']}>
      <span
        class="text-eyebrow block font-inter text-[clamp(0.7256rem,0.6104rem_+_0.5759vw,1.1288rem)] leading-[1.6] font-normal tracking-normal text-black"
      >
        {hero?.eyebrow}
      </span>
      <h1 class="font-lora text-h1 leading-[1.25] font-medium tracking-[clamp(-0.03rem,0.0013rem_-_0.0348vw,-0.0056rem)]">
        {hero?.headline}
      </h1>
      <p class="text-body font-inter text-body leading-[1.6] font-medium tracking-normal">
        {hero?.subtitle}
      </p>
    </div>
  </section>

  <!-- FILTER PILLS -->
  <FilterPills categories={WORK_FILTER_CATEGORIES} />

  <!-- MARQUEE LOGOS -->
  <section class="section section--marquee pt-0 pb-[clamp(4.0162rem,3.3787rem_+_3.1875vw,6.2475rem)]">
    <MarqueeLogos />
  </section>

  <!-- CATEGORY SLIDERS o WORK GRID (SHOW_WORK_SLIDERS) -->
  {/* Cada grilla sigue el patrón de `resources-grid` (3 columnas; 1 en mobile). La card
      llena su columna con la imagen cuadrada vía overrides desde el padre, como
      `ServiceCategoryBlock`, para no tocar su tamaño en los sliders. El título, el gap
      entre bloques y el `scroll-margin-top` son los de `CardsSlider` / `CategorySliders`. */}
  {
    SHOW_WORK_SLIDERS ? (
      <CategorySliders categories={WORK_BY_CATEGORY} />
    ) : (
      <section class="section section--work-grid pt-0 pb-[clamp(5.8275rem,4.9025rem_+_4.625vw,9.065rem)]">
        <div class="container mx-auto flex w-full max-w-(--container-max-width) flex-col gap-[clamp(1.6087rem,1.3534rem_+_1.2768vw,2.5025rem)] px-container-x">
          {GRID_GROUPS.map((group) => (
            <div id={group.id} class="category-anchor flex scroll-mt-[clamp(4.5rem,3.7857rem_+_3.5714vw,7rem)] flex-col gap-sm">
              <h2 class="work-grid-title font-inter text-[clamp(1.25rem,1.2321rem_+_0.0893vw,1.3125rem)] leading-[1.5] font-medium tracking-normal">
                {group.label}
              </h2>
              <div class="work-grid grid grid-cols-3 gap-x-[clamp(0.5223rem,0.4394rem_+_0.4146vw,0.8125rem)] gap-y-[clamp(3.6161rem,3.0421rem_+_2.8699vw,5.625rem)] max-md:grid-cols-1 max-md:gap-[1.125rem] [&_.card--work]:w-full [&_.card-work-bg]:aspect-square [&_.card-work-bg]:h-auto">
                {group.items.map((work) => <WorkCard {...work} />)}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }
</Page>
