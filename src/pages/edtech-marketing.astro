---
/**
 * EdTech Marketing — 27zero
 * Portado 1:1 de `/edtech-marketing/index.html` + `/edtech-marketing/style.css` del
 * repo vanilla. Clases propias documentadas en `design-system-edtech-marketing.md`.
 *
 * El hero comparte clases (`.section--hero-marketing`) con el de About, que en el
 * vanilla se describe como derivado de este — pero los valores NO son iguales
 * (padding, gap del container y el bloque `.hero-home-cta`, que About no tiene), así
 * que cada página declara los suyos y no se extrae un componente compartido.
 *
 * Valores fluidos con la curva del resto del proyecto: mobile = `em × 9` @320px,
 * desktop = `em × 14` @1440px, salvo donde el vanilla fija un valor mobile propio en
 * su `@media (max-width: 768px)` — ahí el `clamp()` usa los px reales de cada extremo.
 */
import Page from '../layouts/Page.astro';
import { getPageSeo } from '../lib/sanity/settings';
import ServiceMenu from '../components/sections/ServiceMenu.astro';
import ShapesSlider from '../components/sections/ShapesSlider.astro';
import Button from '../components/ui/Button.astro';
import PracticeIcon from '../components/ui/PracticeIcon.astro';
import PracticesCard from '../components/ui/PracticesCard.astro';
import { sanityClient } from '../lib/sanity/client';
import { toImage } from '../lib/sanity/image';
import { edtechMarketingQuery } from '../lib/sanity/queries';
import { practiceUrl, serviceUrl } from '../lib/utils/routes';
import type { PracticeIconId, SanityImage, ServiceCategoryId, ServiceIconId } from '../types/sanity';
import { SERVICE_CATEGORY_LABELS, SERVICE_CATEGORY_ORDER } from '../types/sanity';
import type { ServiceGroup } from '../types/ui';

const { practices, services, settings } = await sanityClient.fetch<{
  practices: {
    _id: string;
    title: string;
    slug: string;
    shortDescription?: string;
    cardImage?: SanityImage;
  }[];
  services: { _id: string; title: string; slug: string; category: ServiceCategoryId; iconId?: ServiceIconId }[];
  settings: {
    servicesTitle?: string;
    servicesDescription?: string;
    agencyHero?: {
      headline?: string;
      text?: string;
      image?: SanityImage;
      ctaLink?: string;
      ctaCaption?: string;
    };
    agencyPracticesSection?: { headline?: string; text?: string };
    agencyClosingCta?: { headline?: string; ctaLink?: string };
  } | null;
}>(edtechMarketingQuery);

/* El body de la card sale de `shortDescription`, sin fallback: `description` era el
   campo duplicado que el brief de Etapa 5 dejó marcado, y se borró del schema.
   `shortDescription` es requerido, así que la card siempre tiene copy. */
const PRACTICES = practices.map((practice) => ({
  href: practiceUrl(practice.slug),
  title: practice.title,
  body: practice.shortDescription ?? undefined,
  /* `toImage()` devuelve `undefined` si falta el asset o el `alt` (CLAUDE.md §8.1) y ahí
     la card cae a su placeholder. Hoy es el caso de las 3: `cardImage` está vacía en
     todos los documentos. */
  image: toImage(practice.cardImage, { width: 700 }),
}));

/* Los 3 íconos de `.practices-card` son fijos y POSICIONALES: el primero de la grilla
   siempre lleva `waves`, el segundo `spiral` y el tercero `square-circle`, sin importar
   qué práctica caiga en cada posición. Es el mismo orden en que están hardcodeados en
   `/edtech-marketing/index.html` del vanilla.

   No salen de Sanity a propósito. Antes se leía `practice.iconId`, que casi ningún
   documento tenía cargado, así que el slot no recibía contenido y las cards se
   construían con el `.practices-card-icon` VACÍO (la fallback del `<slot>` tampoco se
   disparaba: Astro no resuelve un `slot="icon"` que vive dentro de una expresión
   condicional). Son 3 íconos de marca atados a la maquetación, no contenido editable
   — CLAUDE.md §4 los deja del lado estático, y el campo ya se borró del schema. */
const PRACTICE_ICONS: PracticeIconId[] = ['waves', 'spiral', 'square-circle'];

/* El orden de las 8 categorías es de diseño, no un dato del CMS: `category` es una
   `options.list` sin campo de orden, así que se recorre `SERVICE_CATEGORY_ORDER` (el
   orden del Figma) en vez de dejar que lo decida el alfabeto. Las categorías sin
   servicios cargados no se renderizan — un `.menu-block` con título y grid vacío no
   comunica nada.

   El ícono del servicio sale de `iconId` y, si el editor no lo eligió, se rota entre
   los 3 marcos de marca reiniciando en cada categoría, que es exactamente lo que hace
   el vanilla (ahí ningún servicio tiene ícono propio). */
const ICON_ROTATION: ServiceIconId[] = ['asterisk', 'quatrefoil', 'arc'];

const SERVICES_BY_CATEGORY: ServiceGroup[] = SERVICE_CATEGORY_ORDER.flatMap((categoryId) => {
  const items = services.filter((service) => service.category === categoryId);
  if (items.length === 0) return [];

  return [
    {
      title: SERVICE_CATEGORY_LABELS[categoryId],
      services: items.map((service, index) => ({
        href: serviceUrl(service.slug),
        title: service.title,
        iconId: service.iconId ?? ICON_ROTATION[index % ICON_ROTATION.length],
      })),
    },
  ];
});

/* Fieldset `services` de `settings` (agregado en Etapa 5). El singleton todavía está
   vacío, así que el copy aprobado del Figma queda como default y el campo de Sanity
   actúa de override — mismo patrón de fallback que CLAUDE.md §8.1 define para SEO. */
const SERVICES_INTRO = {
  title: settings?.servicesTitle ?? "What's on the menu?",
  description:
    settings?.servicesDescription ??
    'Wherever you are in your marketing cycle, we have something cooking — strategy, creativity, and execution, ready to serve when you are.',
};

const CONTAINER = 'container mx-auto flex w-full max-w-(--container-max-width) flex-col px-container-x';

const BODY = 'text-body font-inter text-body leading-[1.6] font-medium tracking-normal';

/* Placeholder de wireframe (fondo gris + label en mayúsculas al 40%), mismo tratamiento
   que en Home y About. */
const PLACEHOLDER_LABEL =
  'font-inter text-[clamp(0.5625rem,0.4732rem_+_0.4464vw,0.875rem)] font-semibold tracking-[1px] text-black uppercase opacity-40';

/* Fondo full-bleed del hero. `toImage()` y no `ogImageUrl()`: ese último recorta a
   1200×630 para la tarjeta de Open Graph y deformaría el fondo (mismo criterio que el
   poster del hero de Home y el de About, Etapa 10). Sin imagen cargada — o sin `alt` —
   queda `undefined` y el hero cae al placeholder. */
const HERO_IMAGE = toImage(settings?.agencyHero?.image, { width: 1920 });

/* SEO de esta página: `settings.agencySeo` en Sanity, con fallback global.
   `getPageSeo()` memoiza el singleton — una sola query para todo el build. */
const { seo, siteSettings } = await getPageSeo('agency');
---

<Page seo={seo} siteSettings={siteSettings} navVariant="white">
  <!-- HERO -->
  <section
    class="section section--hero-marketing relative mt-[clamp(6.0019rem,5.2167rem_+_3.9259vw,8.75rem)] overflow-hidden pt-[clamp(3.7538rem,8.9729rem_-_5.7991vw,7.8131rem)] pb-[clamp(7.4988rem,11.9168rem_-_4.9089vw,10.935rem)]"
  >
    {
      HERO_IMAGE ? (
        <img
          src={HERO_IMAGE.src}
          alt={HERO_IMAGE.alt}
          class="hero-marketing-bg absolute inset-0 z-0 size-full object-cover"
        />
      ) : (
        <div class="hero-marketing-bg absolute inset-0 z-0 flex items-center justify-center bg-gray">
          <span class={PLACEHOLDER_LABEL}>[HERO BACKGROUND IMAGE]</span>
        </div>
      )
    }

    <div
      class:list={[
        CONTAINER,
        'hero-marketing-container relative z-[1] gap-[clamp(1.2038rem,1.0127rem_+_0.9554vw,1.8725rem)]',
      ]}
    >
      <div class="hero-marketing-text flex max-w-[50%] flex-col gap-xs max-md:max-w-full">
        <h1 class="font-lora text-h1 leading-[1.25] font-medium tracking-[-0.48px]">
          {settings?.agencyHero?.headline}
        </h1>
        <p class:list={[BODY, 'max-w-[90%] text-black']}>
          {settings?.agencyHero?.text}
        </p>
      </div>

      {/* Botón y caption son independientes: la caption no depende de que haya link
          cargado, igual que en el hero de Home. */}
      <div class="hero-home-cta mr-auto flex flex-col items-center gap-xs">
        {
          settings?.agencyHero?.ctaLink && (
            <Button href={settings.agencyHero.ctaLink} variant="white" class="border-white!">
              Book a strategy session
            </Button>
          )
        }
        {
          settings?.agencyHero?.ctaCaption && (
            <p class="text-caption font-inter text-body-sm leading-[1.6] font-normal tracking-normal text-black">
              {settings.agencyHero.ctaCaption}
            </p>
          )
        }
      </div>
    </div>
  </section>

  {/* PENDIENTE (planning-maquetado-edtech-marketing.md #2): 2 de las 3 shapes siguen
      con lorem ipsum a la espera del copy del cliente — desde la Sesión 5 ese contenido
      vive en `settings.apartSection`, así que se resuelve cargándolo en el Studio. */}
  <ShapesSlider />

  <!-- PRACTICES -->
  <section
    class="section section--practices bg-indigo pt-[clamp(5.0231rem,4.2258rem_+_3.9866vw,7.8137rem)] pb-[clamp(6.0244rem,5.0681rem_+_4.7812vw,9.3712rem)]"
  >
    <div class:list={[CONTAINER, 'practices-container gap-[clamp(4.0162rem,3.3787rem_+_3.1875vw,6.2475rem)]']}>
      <div class="practices-intro flex flex-col gap-[clamp(0.3994rem,0.336rem_+_0.317vw,0.6212rem)]">
        <h2 class="font-lora text-h2 leading-[1.25] font-medium tracking-[-0.42px] text-white">
          {settings?.agencyPracticesSection?.headline}
        </h2>
        <p
          class="text-body--sm max-w-[clamp(19.125rem,16.0893rem_+_15.1786vw,29.75rem)] font-inter text-body-sm leading-[1.6] font-normal tracking-normal text-white/85 max-md:max-w-full"
        >
          {settings?.agencyPracticesSection?.text}
        </p>
      </div>

      {/* Mobile: el grid pasa a carrusel horizontal con scroll-snap y las cards toman
          tamaño fijo (300×380), igual que el vanilla. */}
      <div
        class="practices-grid grid grid-cols-3 gap-[clamp(1.2038rem,1.0127rem_+_0.9554vw,1.8725rem)] max-md:flex max-md:snap-x max-md:snap-mandatory max-md:overflow-x-auto max-md:[scrollbar-width:none] max-md:[&::-webkit-scrollbar]:hidden max-md:[&_.practices-card]:h-[23.75rem] max-md:[&_.practices-card]:w-[18.75rem] max-md:[&_.practices-card]:flex-[0_0_18.75rem] max-md:[&_.practices-card]:snap-start"
      >
        {
          PRACTICES.map((practice, index) => (
            <PracticesCard href={practice.href} title={practice.title} body={practice.body} image={practice.image}>
              <PracticeIcon slot="icon" iconId={PRACTICE_ICONS[index % PRACTICE_ICONS.length]} />
            </PracticesCard>
          ))
        }
      </div>
    </div>
  </section>

  <!-- MENU -->
  <section
    class="section section--menu bg-black pt-[clamp(4.0162rem,3.3787rem_+_3.1875vw,6.2475rem)] pb-[clamp(6.0244rem,5.0681rem_+_4.7812vw,9.3712rem)]"
  >
    {/* `.menu-container` es un `.container` pero en grid, no en columna flex. */}
    <div
      class="container menu-container mx-auto grid w-full max-w-(--container-max-width) grid-cols-[0.45fr_1fr] items-start gap-[clamp(4.6181rem,3.8851rem_+_3.6652vw,7.1838rem)] px-container-x max-md:grid-cols-1 max-md:gap-[2.4131rem]"
    >
      <div class="menu-intro flex flex-col gap-[clamp(1.4063rem,1.183rem_+_1.1161vw,2.1875rem)]">
        <h2
          class="font-lora text-[clamp(1.75rem,1.6075rem_+_0.7125vw,2.2487rem)] leading-[1.25] font-medium tracking-[-0.36px] text-white"
        >
          {SERVICES_INTRO.title}
        </h2>
        <p class:list={[BODY, 'text-white/85']}>{SERVICES_INTRO.description}</p>
      </div>

      <ServiceMenu categories={SERVICES_BY_CATEGORY} />
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section
    class="section section--closing-cta bg-white py-[clamp(3.7519rem,3.3963rem_+_1.7777vw,4.9962rem)] text-center"
  >
    <div
      class:list={[
        CONTAINER,
        'closing-cta-container items-center gap-[clamp(1.2038rem,1.0127rem_+_0.9554vw,1.8725rem)]',
      ]}
    >
      <h2 class="max-w-[50%] font-lora text-h2 leading-[1.25] font-medium tracking-[-0.42px] text-black max-md:max-w-full">
        {settings?.agencyClosingCta?.headline}
      </h2>
      {
        settings?.agencyClosingCta?.ctaLink && (
          <Button href={settings.agencyClosingCta.ctaLink} variant="blackWhite">
            Book a strategy session
          </Button>
        )
      }
    </div>
  </section>
</Page>
