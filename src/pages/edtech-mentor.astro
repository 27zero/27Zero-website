---
/**
 * The EdTech Mentor — 27zero
 * Portado 1:1 de `/edtech-mentor/index.html` + `/edtech-mentor/style.css` del repo
 * vanilla. Clases propias en `design-system-edtech-mentor.md`.
 *
 * Desde Etapa 11 la página no tiene secciones fijas: itera sobre los documentos
 * `mentorCategory` ordenados por `order`, así que agregar, sacar o reordenar una serie
 * es contenido y no un deploy. Hoy son 4 (Essential, Investor, Founders, CEOs) contra
 * las 3 hardcodeadas que había antes.
 *
 * El `id` de cada sección — y el `data-filter` de su pill — es el slug de la
 * categoría. El typo `essencial` del vanilla quedó corregido en la taxonomía desde
 * Etapa 5, así que acá no hay nada que normalizar.
 *
 * Valores fluidos con la curva del resto del proyecto: mobile = `em × 9` @320px,
 * desktop = `em × 14` @1440px, salvo donde el vanilla fija un valor mobile propio.
 */
import Page from '../layouts/Page.astro';
import { getMentorContent, getPageSeo } from '../lib/sanity/settings';
import FilterPills from '../components/sections/FilterPills.astro';
import MentorCategorySection from '../components/sections/MentorCategorySection.astro';
import Button from '../components/ui/Button.astro';
import EdtechMentorCard from '../components/ui/EdtechMentorCard.astro';
import FeaturedCard from '../components/ui/FeaturedCard.astro';
import { toMentorCard } from '../lib/sanity/cards';
import type { MentorCardProjection } from '../lib/sanity/cards';
import { sanityClient } from '../lib/sanity/client';
import { mentorListQuery } from '../lib/sanity/queries';
import { DEFAULT_ACCENT } from '../lib/utils/color';
import { mentorCategoryPageSlugs, mentorCategorySlug, mentorCategoryUrl } from '../lib/utils/routes';
import type { PortableTextBlock } from '../types/sanity';
import type { MentorCardData, MentorCategoryGroup } from '../types/ui';

const CONTAINER = 'container mx-auto flex w-full max-w-(--container-max-width) flex-col px-container-x';

/* Nota 6 — espaciados del tope de la página, fluidos en todos los breakpoints.
   Segunda ronda: hero de 2rem (mobile) a 8rem (desktop). En mobile los 2rem (32px)
   quedan por debajo del alto del navbar fijo (45px); valor pedido explícitamente. */
const HERO_PT = 'pt-[clamp(2rem,0.2857rem_+_8.5714vw,8rem)]';
const PILLS_PB = 'pb-[clamp(1.6rem,1.4857rem_+_0.5714vw,2rem)]';

/** Newsletter de The EdTech Mentor en LinkedIn — destino de los "Subscribe on
    LinkedIn" de esta página (el pill inline y el pill flotante). Literal y no campo
    de Sanity: es una propiedad de 27zero, no contenido que el editor vaya a cambiar
    (mismo criterio que los links de "Book a strategy session" de Etapa 10).

    NO confundir con `edtechMentor.linkedinUrl`, que sí sale del CMS: ese es el post
    de LinkedIn de un episodio puntual y lo usa la interna, no este botón. */
const LINKEDIN_NEWSLETTER_URL =
  'https://www.linkedin.com/newsletters/7057097071853461504/?displayConfirmation=true';

/** Una categoría tal como la devuelve `mentorListQuery`. */
interface MentorCategoryProjection {
  _id: string;
  title: string;
  /** Opcional en el schema: vacío → `mentorCategorySlug` lo arma con el título. */
  slug: string | null;
  color?: string | null;
  textColor?: string | null;
  sectionHeadline?: PortableTextBlock[];
  sectionSubtitle?: string;
  interviewCount: number;
  /** Referencias expandidas: una entrevista sin publicar o borrada llega `null`. */
  featuredInterviews?: (MentorCardProjection | null)[] | null;
  latestInterviews: MentorCardProjection[];
}

const { featured, categories, interviews } = await sanityClient.fetch<{
  featured: MentorCardProjection | null;
  categories: MentorCategoryProjection[];
  interviews: MentorCardProjection[];
}>(mentorListQuery);

/* Nota 14: el destacado usa `bannerPost` (horizontal) y no el `thumbnail` cuadrado.
   Ancho = el del wrapper a container completo (90rem) × 2 para pantallas densas, con
   el mismo tope de 1600 que el hero de la interna. */
const FEATURED_MENTOR: MentorCardData | null = featured
  ? toMentorCard(featured, { image: 'bannerPost', imageWidth: 1600 })
  : null;

/* Categorías con página propia: la misma regla que genera `/edtech-mentor/[category]`,
   así el "View All" nunca apunta a una ruta que no existe. */
const CATEGORY_PAGES = mentorCategoryPageSlugs(
  categories.map((category) => ({ slug: mentorCategorySlug(category), interviewCount: category.interviewCount })),
  interviews.map((mentor) => mentor.slug)
);

/* Una categoría sin entrevistas no se renderiza: una sección sin cards deja el headline
   colgado y un pill que salta a la nada. Cargarle entrevistas la hace volver sola.

   Slider (Nota 3.3): la selección curada de `featuredInterviews`, en el orden del
   Studio. Si la categoría no tiene ninguna curada (hoy es el caso de todas), cae a
   sus 10 más recientes — si no, la página se quedaría sin sliders hasta que el
   editor cure cada categoría. */
const MENTOR_CATEGORIES: MentorCategoryGroup[] = categories
  .filter((category) => category.interviewCount > 0)
  .map((category) => {
    const curated = (category.featuredInterviews ?? []).filter(
      (mentor): mentor is MentorCardProjection => Boolean(mentor?.slug)
    );
    const slider = curated.length ? curated : category.latestInterviews;
    /* Slug del Studio o, vacío, el título. Si dos categorías resuelven al mismo slug el
       `id` del anchor queda duplicado: `mentorCategoryPageSlugs` ya avisa por consola y
       se corrige en el Studio. */
    const slug = mentorCategorySlug(category);

    return {
      id: slug,
      title: category.title,
      headline: category.sectionHeadline,
      subtitle: category.sectionSubtitle,
      viewAllHref: CATEGORY_PAGES.has(slug) ? mentorCategoryUrl(slug) : undefined,
      /* Nota 5.3: sin color cargado, negro — en vez del estilo estándar de pill, así
         todos los pills de la fila se comportan igual en hover. */
      color: category.color || DEFAULT_ACCENT,
      textColor: category.textColor ?? undefined,
      items: slider.map((mentor) => toMentorCard(mentor)),
    };
  });

/* Catálogo completo para el buscador — ya no se puede derivar de los sliders, que
   desde la Nota 3.3 muestran como mucho 10 por categoría.

   Nota 4.2: el texto de match junta invitado, rol, empresa, título del episodio,
   categoría y season. Va en un solo `data-search` en minúsculas porque el criterio
   es el mismo para todos (coincidencia parcial en cualquiera). */
const SEARCHABLE_MENTORS = interviews.map((mentor) => ({
  card: toMentorCard(mentor),
  searchText: [
    mentor.guestName,
    mentor.guestRole,
    mentor.guestCompany,
    mentor.title,
    mentor.categoryTitle,
    mentor.season?.title,
  ]
    .filter(Boolean)
    .join(' ')
    .toLowerCase(),
}));

/* Un pill por sección, cada uno con su anchor. Deriva de `MENTOR_CATEGORIES` ya
   filtrado, así que una categoría vacía tampoco deja el pill huérfano.

   Nota 5.1: el pill lleva el color de la categoría (y su `textColor`, segunda ronda),
   ya resueltos al armar `MENTOR_CATEGORIES`. */
const FILTER_CATEGORIES = MENTOR_CATEGORIES.map((category) => ({
  id: category.id,
  label: category.title,
  color: category.color,
  textColor: category.textColor,
}));

/* SEO de esta página: `settings.mentorSeo` en Sanity, con fallback global.
   `getPageSeo()` memoiza el singleton — una sola query para todo el build. */
const { seo, siteSettings } = await getPageSeo('mentor');

/* Misma promesa memoizada que `getPageSeo()` — sin request extra. */
const mentorContent = await getMentorContent();
---

<Page seo={seo} siteSettings={siteSettings} navVariant="white">
  <!-- HERO / INTRO -->
  {/* Nota 6: `padding-top` fluido HERO_PT (ver arriba). */}
  <section class:list={['section section--hero pb-[clamp(0.8438rem,0.4598rem_+_1.9196vw,2.1875rem)]', HERO_PT]}>
    <div class:list={[CONTAINER, 'hero-container gap-xs']}>
      <nav
        class="breadcrumb mb-xs flex items-center gap-xs font-inter text-[clamp(0.5625rem,0.4732rem_+_0.4464vw,0.875rem)] leading-[1.5] font-normal text-black opacity-55"
        aria-label="Breadcrumb"
      >
        <a href="/" class="breadcrumb-link text-current underline hover:text-indigo">Home</a>
        <span class="breadcrumb-separator inline-block">&gt;</span>
        <span class="breadcrumb-current">EdTech Mentor Interviews.</span>
      </nav>
      <h1
        class="font-lora text-[clamp(2rem,1.8464rem_+_0.7679vw,2.5375rem)] leading-[1.25] font-medium tracking-[clamp(-0.0213rem,-0.0012rem_-_0.0223vw,-0.0056rem)]"
      >
        {mentorContent.hero.headline}
      </h1>
      <p class="text-body font-inter text-body leading-[1.6] font-medium tracking-normal">
        {mentorContent.hero.text}
      </p>
    </div>
  </section>

  <!-- FILTER PILLS -->
  {/* `indent={false}`: a diferencia de Work/Clientes, `.pills-container` acá no lleva
      el indent de 13em — mismo padding estándar que el resto de la página. */}
  {/* `actionPill` abre el modal de búsqueda. Va en esta fila y no suelto entre el
      featured y los sliders: comparte naturaleza con "Subscribe on LinkedIn" (una
      herramienta, no un filtro de categoría) y así no queda un input huérfano entre dos
      bloques grandes. Los pills y los sliders no cambian de estado nunca por la
      búsqueda — el modal es la única superficie que aparece. */}
  {/* Notas 13.1 y 13.2: en mobile el "Subscribe" inline se oculta (lo cubre el pill
      flotante) y las categorías pasan a un `<select>`, sin scroll horizontal.
      Nota 6: `padding-bottom` fluido PILLS_PB. */}
  <FilterPills
    categories={FILTER_CATEGORIES}
    leadPill={{
      label: 'Subscribe on LinkedIn',
      href: LINKEDIN_NEWSLETTER_URL,
      target: '_blank',
      rel: 'noopener',
      class: 'max-md:hidden',
    }}
    actionPill={{ label: 'Search', id: 'mentor-search-open' }}
    indent={false}
    mobileSelect
    paddingBottom={PILLS_PB}
  />

  <!-- FEATURED CARD -->
  <section class="section section--featured-mentor pt-0 pb-[clamp(3.6563rem,3.0759rem_+_2.9018vw,5.6875rem)]">
    <div class={CONTAINER}>
      <div class="featured-mentor-wrap h-[clamp(20rem,14.7321rem_+_26.3393vw,38.4375rem)] w-full overflow-hidden">
        {/* Nota 10.2: variante `spotlight` — contenido +40%, texto claro y gradiente fijo. */}
        {FEATURED_MENTOR && <FeaturedCard {...FEATURED_MENTOR} variant="spotlight" />}
      </div>
    </div>
  </section>

  <!-- SECCIONES DE CATEGORÍA -->
  {/* El fondo lo elige la POSICIÓN, no el campo `color` de la categoría: los 3 temas
      del vanilla (indigo / purple / negro) ciclan, así que una cuarta serie vuelve a
      indigo. `MentorCategorySection` resuelve el tema con `themeIndex`. */}

  {
    MENTOR_CATEGORIES.map((category, index) => (
      <MentorCategorySection {...category} themeIndex={index} />
    ))
  }


  <!-- CTA -->
  <section class="section section--cta-mentor bg-white py-[clamp(3.2119rem,2.7021rem_+_2.5491vw,4.9962rem)] text-black">
    <div class:list={[CONTAINER, 'cta-mentor-container gap-[clamp(1.4063rem,1.183rem_+_1.1161vw,2.1875rem)]']}>
      <div class="cta-mentor-title-block flex flex-col gap-[clamp(0.3994rem,0.336rem_+_0.317vw,0.6212rem)]">
        <h2
          class="cta-mentor-title font-lora text-[clamp(1.5rem,1.0711rem_+_2.1446vw,3.0013rem)] leading-[1.25] font-medium tracking-[-0.36px]"
        >
          {mentorContent.cta.headline}
        </h2>
        <p class="text-body max-w-[clamp(24.1088rem,20.282rem_+_19.1339vw,37.5025rem)] font-inter text-body leading-[1.6] font-medium tracking-normal">
          {mentorContent.cta.text}
        </p>
      </div>
      <div class="cta-mentor-actions flex flex-wrap gap-[clamp(0.4219rem,0.3549rem_+_0.3348vw,0.6563rem)] max-md:flex-col max-md:items-baseline">
        {/* Ruta interna fija, no campo de Sanity — mismo criterio que los "Book a
            strategy session" de Etapa 10. */}
        <Button href="/contact" variant="purple">Let's Talk</Button>
        {
          mentorContent.cta.secondaryCtaLink && (
            <Button href={mentorContent.cta.secondaryCtaLink} variant="white">
              {mentorContent.cta.secondaryCtaText ?? 'Learn More'}
            </Button>
          )
        }
      </div>
    </div>
  </section>

  <!-- MODAL DE BÚSQUEDA -->
  {/* Las cards vienen renderizadas del build — las mismas que los sliders, ya
      disponibles acá — y el JS solo togglea visibilidad. Sin templating en runtime, sin
      fetch. Repiten las URLs de imagen de los sliders, así que el navegador las sirve
      de caché y el modal no agrega descargas.

      Todo lo que se muestra/oculta usa el atributo `hidden` y NO una clase de display:
      el reset del proyecto trae `[hidden]{display:none!important}` y una `.flex` en el
      mismo elemento le ganaría. Por eso los contenedores que togglean no llevan clase
      de display propia y el layout vive en un hijo. */}
  <div id="mentor-search-modal" class="fixed inset-0 z-[100]" hidden>
    <div class="absolute inset-0 bg-black/60" data-search-dismiss></div>

    {/* Ancho = exactamente 3 cards + sus 2 gaps + el padding del cuerpo, en tokens y no
        en un rem fijo: son `clamp()` que escalan con el viewport, así que la caja de
        contenido mide siempre 3 cards justas y nunca entra una cuarta. Cuando `94vw`
        recorta por debajo de eso, el `flex-wrap` del grid baja solo a 2 y después a 1 —
        no hace falta un breakpoint por columna.

        `--spacing-card` se redefine acá, en el diálogo, con una curva un poco más chica
        que la global (tope 20rem en vez de 21.875rem). Va en este elemento y no en el
        grid a propósito: el `calc()` de al lado lee la variable del propio elemento, así
        que declararla acá mantiene acoplados el ancho del diálogo y el de las cards que
        contiene. Con la curva global 3 cards recién entraban desde ~1280px; con esta
        entran desde ~1024px. El token gobierna `w-card` y `size-card`, o sea ancho y
        alto a la vez, así que las cards siguen cuadradas — no se deforman.

        El `+ 0.25rem` es holgura contra el redondeo sub-pixel: sin él la caja de
        contenido mide EXACTAMENTE 3 cards y basta una fracción de píxel para que la
        tercera se vaya de fila. 4px no alcanzan para que entre una cuarta, que
        necesitaría una card entera más su gap. */}
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="mentor-search-heading"
      class="[--spacing-card:clamp(15.625rem,13rem_+_7.2vw,20rem)] relative mx-auto mt-[6vh] flex h-[min(85dvh,48rem)] w-[min(94vw,calc(3*var(--spacing-card)_+_2*var(--spacing-sm)_+_2*var(--spacing-gap)_+_0.25rem))] flex-col overflow-hidden rounded-card bg-white max-md:mt-0 max-md:h-[100dvh] max-md:w-full max-md:rounded-none"
    >
      {/* Header `shrink-0` en el tope: en mobile el teclado virtual recorta el viewport
          desde abajo, así que el input tiene que vivir arriba para no quedar tapado.
          Los resultados scrollean debajo. */}
      <div class="flex shrink-0 flex-col gap-sm border-b border-black/10 p-gap">
        <div class="flex items-center justify-between gap-sm">
          <h2 id="mentor-search-heading" class="font-lora text-h4 leading-[1.25] font-medium text-black">
            Search interviews
          </h2>
          <button
            type="button"
            id="mentor-search-close"
            aria-label="Close search"
            class="flex size-icon-btn shrink-0 cursor-pointer items-center justify-center rounded-full border-[0.0625rem] border-black bg-transparent text-black transition-colors duration-200 ease-in-out hover:border-indigo hover:text-indigo"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="6" y1="6" x2="18" y2="18"></line>
              <line x1="18" y1="6" x2="6" y2="18"></line>
            </svg>
          </button>
        </div>

        <label for="mentor-search" class="sr-only">Search interviews by guest, company, topic, category or season</label>
        <div class="relative w-full">
          <svg
            class="pointer-events-none absolute top-1/2 left-[1rem] size-[1.125rem] -translate-y-1/2 text-black/45"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          </svg>
          <input
            id="mentor-search"
            type="search"
            autocomplete="off"
            placeholder="Search by guest, company, topic or season"
            class="w-full rounded-full border-[0.0625rem] border-black/25 bg-transparent py-[clamp(0.5rem,0.4rem_+_0.5vw,0.75rem)] pr-[1.125rem] pl-[2.75rem] font-inter text-body-sm leading-[1.5] font-medium text-black transition-colors duration-200 ease-in-out placeholder:text-black/45 focus:border-indigo focus:outline-none"
          />
        </div>
      </div>

      <div class="grow overflow-y-auto overscroll-contain p-gap">
        {/* El grid va sobre blanco y `role`/`name` de la card son blancos por default
            (legibles sobre indigo/negro en los sliders). Se pisan a indigo con el mismo
            patrón de variante descendente que usa `MentorCategorySection.THEMES` para el
            tema purple — el override es de este contenedor, las cards de los sliders no
            se enteran. */}
        <div
          id="mentor-search-grid"
          hidden
          class="[&_.card-edtech-mentor-name]:text-indigo [&_.card-edtech-mentor-role]:text-indigo"
        >
          <div class="flex flex-wrap gap-sm">
            {
              SEARCHABLE_MENTORS.map(({ card, searchText }) => (
                /* `flex`: el wrapper es el flex item de la grilla y se estira a la altura de la fila,
                   pero la card de adentro no heredaba esa altura, así que el `justify-end` de
                   `EdtechMentorCard` no tenía sobre qué anclar. Con esto la card se estira al
                   wrapper y los cuadrados alinean también acá. El toggle por `.hidden` del script
                   sigue mandando: preflight lo declara `!important`. */
                <div class="mentor-search-item flex" data-search={searchText}>
                  <EdtechMentorCard {...card} />
                </div>
              ))
            }
          </div>
        </div>

        {/* Estado inicial: el modal abre sin cards. Mostrar las 74 de entrada duplicaría
            lo que los sliders ya tienen detrás del overlay y daría un scroll largo antes
            de que el usuario escriba nada. */}
        <p
          id="mentor-search-hint"
          class="font-inter text-body-sm leading-[1.6] font-normal tracking-normal text-black/55"
        >
          Type to search across {SEARCHABLE_MENTORS.length} interviews by guest, role, company, episode title, category or season.
        </p>

        <p
          id="mentor-search-empty"
          hidden
          class="font-inter text-body leading-[1.6] font-medium tracking-normal text-black"
        >
          No interviews match your search. Try a guest’s name, a company or a category.
        </p>

        {/* Solo para lectores de pantalla: el conteo se anuncia al terminar el debounce. */}
        <p id="mentor-search-status" class="sr-only" role="status" aria-live="polite"></p>
      </div>
    </div>
  </div>

  <!-- PILL FLOTANTE "SUBSCRIBE ON LINKEDIN" -->
  {/* Nota 12: fijo abajo a la izquierda. En desktop aparece recién al pasar la fila de
      pills — que es donde vive el "Subscribe" inline — y se queda visible el resto del
      scroll. En mobile (Nota 13.1) está siempre visible: reemplaza al inline, que ahí
      se oculta.

      Sin borde, solo sombra: el pill flota sobre las tres pieles de sección y sobre la
      purple la sombra es lo que lo separa del fondo.

      Oculto con `invisible` y no solo `opacity-0`: `visibility:hidden` lo saca del orden
      de tabulación y del árbol de accesibilidad mientras no se ve. */}
  <a
    id="mentor-subscribe-float"
    href={LINKEDIN_NEWSLETTER_URL}
    target="_blank"
    rel="noopener"
    class="fixed bottom-[clamp(1rem,0.8571rem_+_0.7143vw,1.5rem)] left-container-x z-[90] inline-flex items-center rounded-full bg-purple px-[clamp(1rem,0.8571rem_+_0.7143vw,1.5rem)] py-[clamp(0.5rem,0.4286rem_+_0.3571vw,0.75rem)] font-inter text-button leading-[1.5] font-medium whitespace-nowrap text-black no-underline shadow-[0_0.25rem_1.25rem_rgba(16,16,16,0.35)] transition-[opacity,visibility,translate] duration-300 ease-in-out hover:opacity-85 md:invisible md:translate-y-sm md:opacity-0 md:data-visible:visible md:data-visible:translate-y-0 md:data-visible:opacity-100"
  >
    Subscribe on LinkedIn
  </a>
</Page>

<script>
  // ============================
  // EdTech Mentor — pill flotante (Nota 12)
  // `data-visible` cuando la fila de pills ya salió por ARRIBA del viewport. El
  // atributo solo tiene efecto en desktop: en mobile el pill es siempre visible por CSS.
  // ============================

  const floatingPill = document.getElementById('mentor-subscribe-float');
  const pillsSection = document.querySelector('.section--pills');

  if (floatingPill && pillsSection) {
    new IntersectionObserver(([entry]) => {
      const scrolledPast = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      floatingPill.toggleAttribute('data-visible', scrolledPast);
    }).observe(pillsSection);
  }
</script>


<script>
  // ============================
  // EdTech Mentor — modal de búsqueda de entrevistas
  // Filtra por coincidencia parcial, case-insensitive, contra invitado, rol, empresa,
  // título del episodio, categoría y season (todo junto en `data-search`). Las cards vienen del build: acá solo se togglea
  // visibilidad, nunca se construye markup.
  //
  // Los sliders y los filter pills NO participan de ningún cambio de estado: quedan
  // siempre visibles detrás del overlay. El modal es la única superficie que aparece.
  // ============================

  const trigger = document.getElementById('mentor-search-open');
  const modal = document.getElementById('mentor-search-modal');
  const dialog = modal?.querySelector<HTMLElement>('[role="dialog"]');
  const input = document.getElementById('mentor-search') as HTMLInputElement | null;
  const grid = document.getElementById('mentor-search-grid');
  const hint = document.getElementById('mentor-search-hint');
  const empty = document.getElementById('mentor-search-empty');
  const status = document.getElementById('mentor-search-status');
  const closeBtn = document.getElementById('mentor-search-close');

  if (trigger && modal && dialog && input && grid && hint && empty && status && closeBtn) {
    const items = Array.from(modal.querySelectorAll<HTMLElement>('.mentor-search-item'));
    const FOCUSABLE = 'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])';

    /* Se guarda el scroll para restaurarlo: `overflow:hidden` en el body no lo conserva
       por sí solo en iOS, que además sigue scrolleando el fondo sin el `position:fixed`. */
    let scrollY = 0;

    const render = (raw: string) => {
      const query = raw.trim().toLowerCase();

      if (!query) {
        grid.hidden = true;
        empty.hidden = true;
        hint.hidden = false;
        status.textContent = '';
        return;
      }

      let matches = 0;
      for (const item of items) {
        const hit = (item.dataset.search ?? '').includes(query);
        item.hidden = !hit;
        if (hit) matches++;
      }

      hint.hidden = true;
      grid.hidden = matches === 0;
      empty.hidden = matches > 0;
      status.textContent = matches
        ? `${matches} interview${matches === 1 ? '' : 's'} found`
        : 'No interviews found';
    };

    // Debounce: el filtro recorre ~74 nodos, barato, pero sin esto el `aria-live`
    // narraría un conteo por pulsación.
    let timer: ReturnType<typeof setTimeout>;
    const onInput = () => {
      clearTimeout(timer);
      timer = setTimeout(() => render(input.value), 180);
    };

    const open = () => {
      scrollY = window.scrollY;
      modal.hidden = false;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.width = '100%';
      // `preventScroll`: sin esto el foco automático scrollea el documento de fondo
      // antes de que el bloqueo tome efecto.
      input.focus({ preventScroll: true });
      render(input.value);
    };

    const close = () => {
      modal.hidden = true;
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.width = '';
      window.scrollTo(0, scrollY);
      // El foco vuelve al pill que abrió el modal: sin esto queda en el `<body>` y la
      // navegación por teclado reinicia desde el principio de la página.
      trigger.focus();
    };

    trigger.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    input.addEventListener('input', onInput);
    // El clear nativo de `type="search"` no emite `input` en todos los navegadores.
    input.addEventListener('search', () => render(input.value));

    // Click en el overlay, nunca en el diálogo: el `data-` lo lleva solo la capa de fondo.
    modal.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).hasAttribute('data-search-dismiss')) close();
    });

    document.addEventListener('keydown', (e) => {
      if (modal.hidden) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }

      if (e.key !== 'Tab') return;

      // Focus trap: el Tab cicla dentro del diálogo en vez de escapar al fondo, que
      // sigue en el DOM y es tabbable. Se recalcula en cada Tab porque los resultados
      // cambian los links enfocables mientras se escribe.
      const focusables = Array.from(dialog.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(
        (el) => el.offsetParent !== null
      );
      if (!focusables.length) return;

      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement;

      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }
</script>
