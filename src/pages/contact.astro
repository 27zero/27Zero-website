---
/**
 * Contact ("Let's Talk") — 27zero
 * Portado 1:1 de `/contact/index.html` + `/contact/style.css` del repo vanilla.
 * Clases propias documentadas en `/contact/design-system-contact.md`.
 *
 * Contenido editable desde Sanity (Etapa 10): headline y texto del hero, link del
 * CTA, encabezado del formulario, título de "Two more ways to start" y las dos
 * cards salen del singleton `settings` vía `getContactContent()`. Las direcciones
 * de oficina salen de `siteSettings.offices` — el mismo array que ya alimenta el
 * JSON-LD, no una proyección aparte.
 *
 * El logo del form (`.contact-form-logo`) usa el asset self-hosteado
 * (`/assets/logo-27zero.svg`), no el CDN de Webflow del vanilla (CLAUDE.md: assets
 * self-hosted) — mismo asset que ya usan Navbar/Footer.
 *
 * El formulario ya no es el `<form>` vanilla con submit placeholder: es un embed de
 * HubSpot (`js.hsforms.net/forms/v2.js`) que maneja su propio submit, con
 * verificación anti-spam contra `oopspam.digital-efd.workers.dev` antes de dejar
 * pasar el envío.
 */
import Page from '../layouts/Page.astro';
import { getContactContent, getPageSeo } from '../lib/sanity/settings';
import Button from '../components/ui/Button.astro';

const CONTAINER = 'container mx-auto flex w-full max-w-(--container-max-width) flex-col px-container-x';

/* Título del hero y de "Two more ways to start": mismo tratamiento tipográfico
   (Lora 500, 48px desktop / 36px mobile, letter-spacing proporcional -0.48/-0.36px). */
const SECTION_HEADING =
  'font-lora text-[clamp(2.25rem,2.0354rem_+_1.0732vw,3.0013rem)] leading-[1.25] font-medium tracking-[clamp(-0.03rem,-0.0204rem_-_0.0107vw,-0.0225rem)] text-white text-center';

const BODY = 'text-body font-inter leading-[1.6] font-normal tracking-normal';

/* La bandera no es contenido editable: sale de `office.country`, que es un código
   ISO fijo que pone el schema, no texto suelto que el editor pueda romper. */
const OFFICE_FLAGS: Record<'US' | 'CO', string> = { US: '🇺🇸', CO: '🇨🇴' };

/* Ícono decorativo de las contact-card: idéntico en ambas, `fill="black"` fijo (no
   currentColor) — el hover de la card solo afecta a `.contact-card-arrow`, tal cual
   el vanilla. */
const CARD_ICON_PATH =
  'M38.87 38.86L38.55 24.46C35.42 33.03 28.46 38.75 19.35 38.86L19.06 25.09C15.51 33.29 9.14 38.7 0 38.87V-1.0866e-05C8.93 -0.0700109 15.41 5.42999 19.06 13.54L19.39 0.0299891C28.16 -0.140011 35.55 5.67999 38.5 14.47L38.8 0.00998913C49.45 -0.100011 58.13 8.57999 58.2 19.23C58.27 29.58 50.19 38.58 38.86 38.85L38.87 38.86Z';

/* SEO de esta página: `settings.contactSeo` en Sanity, con fallback global.
   `getPageSeo()` memoiza el singleton — una sola query para todo el build, y
   `getContactContent()` sale de esa misma promesa, sin fetch extra. */
const { seo, siteSettings } = await getPageSeo('contact');
const contactContent = await getContactContent();

/* Dos campos fijos, no un array: el grid es de 2 columnas y el schema los modela
   así a propósito (Etapa 10, Sesión 1). Ambas se renderizan siempre, tengan o no
   `link`/`bgImageUrl`. */
const contactCards = [contactContent.bookCard, contactContent.subscribeCard];
---

<Page seo={seo} siteSettings={siteSettings} navVariant="white">
  <section
    class="section section--main-contact mt-[clamp(5.625rem,4.7321rem_+_4.4643vw,8.75rem)] bg-indigo pt-[clamp(5.6262rem,10.4485rem_-_5.358vw,9.3769rem)] pb-[clamp(3.1275rem,1.5211rem_+_8.0321vw,8.75rem)]"
  >
    <div class:list={[CONTAINER, 'main-contact-container gap-[clamp(2.8125rem,2.3661rem_+_2.2321vw,4.375rem)]']}>
      <!-- Bloque de título -->
      <div class="main-contact-title-block flex flex-col items-center gap-[clamp(1.6087rem,1.3534rem_+_1.2768vw,2.5025rem)] text-center">
        <h1 class={SECTION_HEADING + ' max-w-[50%] max-md:max-w-full'}>
          {contactContent.headline}
        </h1>
        <p class:list={[BODY, 'text-white']}>
          {contactContent.text}
        </p>
        {
          contactContent.ctaLink && (
            <Button href={contactContent.ctaLink} target="_blank" rel="noopener noreferrer" variant="whiteIndigo">
              Book a strategy session
            </Button>
          )
        }
      </div>

      <!-- Bloque de formulario -->
      <div
        class="main-contact-form-block flex w-full flex-col gap-[clamp(1.6875rem,1.4196rem_+_1.3393vw,2.625rem)] rounded-[0.625rem] bg-white py-[clamp(2.5rem,1.9643rem_+_2.6786vw,4.375rem)] px-[clamp(1.5rem,0.5rem_+_5vw,5rem)]"
      >
        <div class="contact-form-header flex flex-col items-center gap-[clamp(0.2813rem,0.2366rem_+_0.2232vw,0.4375rem)] text-center">
          <h2 class="font-lora text-[clamp(1.5rem,1.3561rem_+_0.7196vw,2.0038rem)] leading-[1.25] font-medium tracking-[clamp(-0.02rem,-0.0136rem_-_0.0071vw,-0.015rem)] text-indigo">
            {contactContent.formTitle}
          </h2>
          <p class:list={[BODY, 'text-black']}>{contactContent.formSubtitle}</p>
        </div>

        <div id="hubspot-form"></div>

        <div class="contact-form-footer flex flex-col gap-[clamp(0.9619rem,0.8092rem_+_0.7634vw,1.4963rem)]">
          <img
            src="/assets/logo-27zero.svg"
            alt="27zero"
            class="contact-form-logo block h-auto w-[clamp(6.75rem,5.6786rem_+_5.3571vw,10.5rem)]"
          />
          <div class="contact-form-locations flex gap-[clamp(1.5rem,1.2136rem_+_1.4321vw,2.5025rem)] max-md:flex-wrap">
            {
              siteSettings.offices?.map((office) => (
                <div class="contact-form-location flex flex-col gap-[clamp(0.1631rem,0.1372rem_+_0.1295vw,0.2537rem)]">
                  <span class="contact-form-location-name mb-[clamp(0.1631rem,0.1372rem_+_0.1295vw,0.2537rem)] font-inter text-[clamp(0.8125rem,0.7946rem_+_0.0893vw,0.875rem)] leading-[1.6] font-bold tracking-normal text-black">
                    {OFFICE_FLAGS[office.country]} {office.label}
                  </span>
                  {/* `whitespace-pre-line`: el address llega de Sanity como texto plano con
                      un salto embebido ("Granville, OH\n110 Bedwen Bach Lane, 43023"), donde
                      el markup vanilla tenía un `<br />` explícito. */}
                  <p class="contact-form-location-address font-inter text-[clamp(0.8125rem,0.7946rem_+_0.0893vw,0.875rem)] leading-[1.5] font-normal whitespace-pre-line text-black">
                    {office.address}
                  </p>
                  <p class="contact-form-location-phone font-inter text-[clamp(0.8125rem,0.7946rem_+_0.0893vw,0.875rem)] leading-[1.5] font-normal text-black">
                    {office.phone}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <!-- Bloque de título secundario -->
      <div class="main-contact-ways-block">
        <h2 class={SECTION_HEADING}>{contactContent.waysTitle}</h2>
      </div>

      <!-- Bloque de cards -->
      <div class="main-contact-cards-block">
        <div class="contact-cards-grid grid grid-cols-2 gap-[clamp(0.8044rem,0.6767rem_+_0.6384vw,1.2512rem)] max-md:grid-cols-1">
          {
            contactCards.map((card) => (
              <a
                href={card.link}
                target="_blank"
                rel="noopener noreferrer"
                style={card.bgImageUrl ? `background-image: url('${card.bgImageUrl}');` : undefined}
                class="contact-card group/card flex flex-col gap-[clamp(2.4131rem,2.0301rem_+_1.9152vw,3.7538rem)] rounded-[0.625rem] bg-gray bg-cover bg-center pt-[clamp(1.6087rem,1.3534rem_+_1.2768vw,2.5025rem)] px-[clamp(1.2038rem,1.0127rem_+_0.9554vw,1.8725rem)] pb-[clamp(2.0081rem,1.6894rem_+_1.5937vw,3.1237rem)] text-black no-underline"
              >
                <svg
                  width="59"
                  height="39"
                  viewBox="0 0 59 39"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  class="contact-card-icon block h-auto w-[clamp(2.3681rem,1.9922rem_+_1.8795vw,3.6837rem)]"
                  aria-hidden="true"
                >
                  <path d={CARD_ICON_PATH} fill="black" />
                </svg>
                <div class="contact-card-row flex items-end justify-between gap-[clamp(0.8044rem,0.6767rem_+_0.6384vw,1.2512rem)]">
                  <div class="contact-card-body flex flex-col gap-[0.625rem]">
                    <h3 class="contact-card-title font-lora text-[clamp(1.125rem,1.0189rem_+_0.5304vw,1.4963rem)] leading-[1.4] font-medium tracking-normal text-black">
                      {card.title}
                    </h3>
                    <p class="contact-card-subtitle font-inter text-[clamp(0.8125rem,0.7771rem_+_0.1768vw,0.9363rem)] leading-[1.6] font-normal tracking-normal text-black">
                      {card.subtitle}
                    </p>
                  </div>
                  <div class="contact-card-arrow flex size-icon-btn shrink-0 items-center justify-center rounded-full border-[0.0875rem] border-black bg-transparent text-black transition-all duration-200 ease-in-out group-hover/card:bg-black group-hover/card:text-white">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Page>

<!-- Embed de HubSpot. `is:inline` es obligatorio: sin eso Astro bundlea el script
     como módulo ES y `hbspt` (el global que expone v2.js) queda fuera de scope. El
     cuerpo del snippet va tal cual lo entregó HubSpot. -->
<script is:inline src="https://js.hsforms.net/forms/v2.js"></script>
<script is:inline>
hbspt.forms.create({
  target: "#hubspot-form",
  region: "na1",
  portalId: "7512561",
  formId: "dae4eef2-fee1-47a5-9424-5cbf017b46f1",
  onFormReady: function($form) {
    console.log("Form HubSpot listo y conectado.");
  },
  onFormSubmit: function($form) {
    const email = ($form.find('input[name="email"]').val() || "").toLowerCase();
    const message = $form.find('textarea').val() || "";
    fetch("https://oopspam.digital-efd.workers.dev", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email, content: message })
    })
    .then(res => res.json())
    .then(result => {
      console.log("OOPSPAM RESULT:", result);
      const isSafe = result?.raw?.Details?.isContentSpam === "nospam";
      const emailBlocked = result?.raw?.Details?.isEmailBlocked;
      if (isSafe && !emailBlocked) {
        $form.off("submit");
        $form.submit();
      } else {
        const messageDiv = document.createElement("div");
        messageDiv.style.padding = "10px";
        messageDiv.style.margin = "10px 0";
        messageDiv.style.backgroundColor = "#ffe0e0";
        messageDiv.style.color = "#900";
        messageDiv.style.borderRadius = "5px";
        messageDiv.textContent = "Your message was flagged as spam, or this email address is blocked. Please review your information.";
        $form.prepend(messageDiv);
      }
    })
    .catch(err => {
      console.error("Error OOPSpam:", err);
      $form.off("submit");
      $form.submit();
    });
  }
});
</script>
